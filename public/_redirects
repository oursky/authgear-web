# Locale path normalisation. The `!` force flag is required because Netlify's
# edge does case-insensitive file lookup: without it, /zh-Hant/foo would hit
# the existing /zh-hant/foo/index.html and silently skip the redirect.
/zh-Hant-TW                                                                         /zh-hant/                                                                                                               301!
/zh-Hant-TW/*                                                                       /zh-hant/:splat                                                                                                         301!
/zh-Hant                                                                            /zh-hant/                                                                                                               301!
/zh-Hant/*                                                                          /zh-hant/:splat                                                                                                         301!
/zh-TW                                                                              /zh-hant/                                                                                                               301!
/zh-TW/*                                                                            /zh-hant/:splat                                                                                                         301!
/zh                                                                                 /zh-hant/                                                                                                               301!
/zh/*                                                                               /zh-hant/:splat                                                                                                         301!

# @astrojs/sitemap emits sitemap-index.xml; alias the conventional path.
/sitemap.xml                                                                        /sitemap-index.xml                                                                                                      301

# /blog/{slug} → /post/{slug} via wildcard. Safe because pagination static
# files (dist/blog/index.html, dist/blog/2/index.html, ...) take precedence
# over non-force rules, so /blog/, /blog/2, etc. are not redirected.
/blog/:slug                                                                         /post/:slug                                                                                                             301
/zh-hant/blog/:slug                                                                 /zh-hant/post/:slug                                                                                                     301

