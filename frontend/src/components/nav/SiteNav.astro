---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import {
  productsDropdownColumns,
  solutionsDropdownLinks,
  solutionsSideImage,
  resourcesDropdownLinks,
  developersDropdownLinks,
  type NavLink,
  type NavColumn,
} from '@/lib/navigation-data';
import SolutionsNavIcons from './SolutionsNavIcons.astro';
import ResourcesDevelopersNavIcons from './ResourcesDevelopersNavIcons.astro';

interface Props {
  locale: string;
}
const { locale } = Astro.props;

function label(link: NavLink): string {
  return link.label[locale] ?? link.label['en'] ?? '';
}

function href(pathOrUrl: string): string {
  if (pathOrUrl.startsWith('http')) return pathOrUrl;
  return localizedPath(locale, pathOrUrl);
}

function renderProductColumn(col: NavColumn) {
  const simple = col as { subtitle: Record<string, string>; links: NavLink[] };
  return {
    subtitle: simple.subtitle[locale] ?? simple.subtitle['en'],
    links: simple.links,
  };
}

const sideHref = href(solutionsSideImage.path);
const sideAlt = solutionsSideImage.alt[locale] ?? solutionsSideImage.alt['en'] ?? '';
---

<div class="container-header">
  <a
    href={localizedPath(locale, '/')}
    id="w-node-_60c42e91-3cdd-38fc-0e84-178975fa9ba3-75fa9b9e"
    class="brand w-nav-brand"
  >
    <img src="/images/authgear-logo.svg" alt={t(locale, 'Navigation.logoAlt')} class="header-logo" />
  </a>

  <nav
    role="navigation"
    id="w-node-_60c42e91-3cdd-38fc-0e84-178975fa9ba5-75fa9b9e"
    class="nav-menu w-nav-menu"
  >
    {/* Products */}
    <div data-delay="0" data-hover="true" class="nav-menu-dropdown w-dropdown">
      <div class="dropdown-toggle w-dropdown-toggle">
        <div class="nav-menu-dropdown-toggle-title">{t(locale, 'Navigation.products')}</div>
        <div class="nav-menu-dropdown-icon w-icon-dropdown-toggle"></div>
      </div>
      <nav class="nav-menu-dropdown-list-full-width w-dropdown-list">
        <div class="nav-full-width-wrapper">
          <div class="nav-full-width-inner">
            {productsDropdownColumns.map((col) => {
              if (col.type === 'stacked') {
                return (
                  <div class="nav-menu-dropdown-column">
                    <div class="nav-full-width-vertical-block">
                      {col.sections.map((sec) => (
                        <div class="nav-menu-dropdown-column">
                          <div class="nav-menu-dropdown-subtitle">
                            {sec.subtitle[locale] ?? sec.subtitle['en']}
                          </div>
                          <div class="nav-menu-dropdown-column-links">
                            {sec.links.map((item) => (
                              <a href={href(item.path!)} class="nav-menu-dropdown-link w-inline-block">
                                <div>{label(item)}</div>
                              </a>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              }

              if (col.type === 'productColumn') {
                return (
                  <div class="nav-menu-dropdown-column">
                    <div class="nav-menu-dropdown-column-links">
                      <div class="nav-menu-dropdown-subtitle product">
                        {col.subtitle[locale] ?? col.subtitle['en']}
                      </div>
                      {col.links.map((item) => {
                        const rawHtml = item.html ? (item.html[locale] ?? item.html['en'] ?? '') : null;
                        return (
                          <a href={href(item.path!)} class="nav-menu-dropdown-link products w-inline-block">
                            <div>
                              {rawHtml
                                ? <span set:html={rawHtml.replace('<br>', '<br />')} />
                                : label(item)
                              }
                            </div>
                          </a>
                        );
                      })}
                    </div>
                  </div>
                );
              }

              {/* Simple column — col.type is undefined */}
              const simpleData = renderProductColumn(col);
              return (
                <div class="nav-menu-dropdown-column">
                  <div class="nav-menu-dropdown-column">
                    <div class="nav-menu-dropdown-subtitle">
                      {simpleData.subtitle}
                    </div>
                    <div class="nav-menu-dropdown-column-links">
                      {simpleData.links.map((item) => (
                        <a href={href(item.path!)} class="nav-menu-dropdown-link w-inline-block">
                          <div>{label(item)}</div>
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </nav>
    </div>

    {/* Solutions */}
    <div data-hover="true" data-delay="0" class="nav-menu-dropdown w-dropdown">
      <div class="dropdown-toggle w-dropdown-toggle">
        <div class="nav-menu-dropdown-toggle-title">{t(locale, 'Navigation.solutions')}</div>
        <div class="nav-menu-dropdown-icon w-icon-dropdown-toggle"></div>
      </div>
      <nav class="nav-menu-dropdown-list w-dropdown-list">
        <div class="nav-menu-dropdown-column">
          <div class="nav-menu-dropdown-column-links">
            {solutionsDropdownLinks.map((item) => (
              <a href={href(item.path!)} class="nav-menu-dropdown-link w-inline-block">
                <div class="w-embed nav-dropdown-icon-embed">
                  <SolutionsNavIcons name={item.path!} />
                </div>
                <div>{label(item)}</div>
              </a>
            ))}
          </div>
        </div>
        <div class="nav-menu-dropdown-column image">
          <a href={sideHref} class="w-inline-block">
            <img
              src={solutionsSideImage.src}
              loading="eager"
              width={solutionsSideImage.width}
              alt={sideAlt}
            />
          </a>
        </div>
      </nav>
    </div>

    {/* Resources */}
    <div data-hover="true" data-delay="0" class="nav-menu-dropdown w-dropdown">
      <div class="dropdown-toggle w-dropdown-toggle">
        <div class="nav-menu-dropdown-toggle-title">{t(locale, 'Navigation.resources')}</div>
        <div class="nav-menu-dropdown-icon w-icon-dropdown-toggle"></div>
      </div>
      <nav class="nav-menu-dropdown-list w-dropdown-list">
        <div class="nav-menu-dropdown-column no-gap">
          {resourcesDropdownLinks.map((item) => (
            <a href={href(item.path!)} class="nav-menu-dropdown-link w-inline-block">
              <div class="w-embed nav-dropdown-icon-embed">
                <ResourcesDevelopersNavIcons name={item.path!} />
              </div>
              <div>{label(item)}</div>
            </a>
          ))}
        </div>
      </nav>
    </div>

    {/* Developers */}
    <div data-hover="true" data-delay="0" class="nav-menu-dropdown w-dropdown">
      <div class="dropdown-toggle w-dropdown-toggle">
        <div class="nav-menu-dropdown-toggle-title">{t(locale, 'Navigation.developers')}</div>
        <div class="nav-menu-dropdown-icon w-icon-dropdown-toggle"></div>
      </div>
      <nav class="nav-menu-dropdown-list developers w-dropdown-list">
        <div class="nav-menu-dropdown-column">
          <div class="nav-menu-dropdown-column-links">
            {developersDropdownLinks.map((item) => (
              <a href={item.href ?? href(item.path!)} class="nav-menu-dropdown-link w-inline-block">
                <div class="w-embed nav-dropdown-icon-embed">
                  <ResourcesDevelopersNavIcons name={item.href ?? item.path ?? ''} />
                </div>
                <div>{label(item)}</div>
              </a>
            ))}
          </div>
        </div>
      </nav>
    </div>

    <ul role="list" class="header-navigation">
      <li class="nav-item-wrapper">
        <a href={localizedPath(locale, '/pricing')} class="nav-link">
          {t(locale, 'Navigation.pricing')}
        </a>
      </li>
    </ul>

    <div class="mobile-nav-buttons">
      <a
        href="https://portal.authgear.com/"
        target="_blank"
        class="nav-button login mobile w-inline-block plausible-event-name--login"
      >
        <div class="text-block-32">{t(locale, 'Navigation.loginMobile')}</div>
      </a>
      <a
        href="https://portal.authgear.com/"
        class="button-primary header-button-mobile signup w-button plausible-event-name--signup"
      >
        {t(locale, 'Navigation.signupMobile')}
      </a>
    </div>
  </nav>

  <div
    id="w-node-_60c42e91-3cdd-38fc-0e84-178975fa9c90-75fa9b9e"
    class="split-content header-right"
  >
    <a href={localizedPath(locale, '/schedule-demo')} class="button-primary header-button w-button">
      {t(locale, 'Navigation.getDemo')}
    </a>
    <a
      href="https://portal.authgear.com/"
      target="_blank"
      class="nav-button login w-inline-block plausible-event-name--login"
    >
      <div>{t(locale, 'Navigation.signupLogin')}</div>
    </a>
    <div class="menu-button w-nav-button">
      <div class="menu-button-wrapper">
        <div class="menu-button-icon">
          <div class="menu-line-top"></div>
          <div class="menu-line-middle"></div>
          <div class="menu-line-bottom"></div>
        </div>
      </div>
    </div>
  </div>
</div>
