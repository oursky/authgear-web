---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import GlossaryPage from '@/components/pages/GlossaryPage.astro';
const locale = 'en';
const title = t(locale, 'Glossary.title');
const description = t(locale, 'Glossary.description');
---
<BaseLayout locale={locale} title={title} description={description}>
  <GlossaryPage locale={locale} />
</BaseLayout>
