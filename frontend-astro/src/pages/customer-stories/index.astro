---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath, pathLocaleToStrapiLocale } from '@/lib/i18n';
import { getCustomerStories, strapiImageUrl } from '@/lib/strapi';

const locale = 'en';
const strapiLocale = pathLocaleToStrapiLocale(locale);

const res = await getCustomerStories({ pagination: { pageSize: 50 }, locale: strapiLocale });
const stories = res.data ?? [];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const title = 'Customer Stories - Authgear';
const description = t(locale, 'CustomerStories.subtitle');
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="page-wrapper">
    <section class="ds-section ds-bg-white ds-customer-stories-index">
      <header class="ds-customer-stories-index__header">
        <div class="ds-container">
          <div class="title-content">
            <h1 class="heading-on-light">{t(locale, 'CustomerStories.title')}</h1>
            <p class="section-lede-on-light">{t(locale, 'CustomerStories.subtitle')}</p>
          </div>
        </div>
      </header>

      <div class="ds-customer-stories-index__main">
        <div class="ds-container">
          {stories.length === 0 ? (
            <div class="empty-state w-dyn-empty">
              <div>{t(locale, 'CustomerStories.noStoriesYet')}</div>
            </div>
          ) : (
            <div role="list" class="case-study-list w-dyn-items">
              {stories.map((story) => {
                const { title: storyTitle, slug, thumbnail } = story.attributes;
                const coverUrl = strapiImageUrl(thumbnail);
                return (
                  <div key={story.id} role="listitem" class="case-study-item-wrap w-dyn-item">
                    <a
                      href={localizedPath(locale, `/customer-stories/${slug}`)}
                      class="case-study-featured-image-wrap w-inline-block"
                    >
                      {coverUrl ? (
                        <img
                          src={coverUrl}
                          alt={storyTitle}
                          width={600}
                          height={400}
                          class="case-study-featured-image"
                          style="object-fit: cover; width: 100%; height: auto;"
                          loading="lazy"
                        />
                      ) : (
                        <div class="case-study-featured-image w-dyn-bind-empty" aria-hidden="true" />
                      )}
                    </a>
                    <a
                      href={localizedPath(locale, `/customer-stories/${slug}`)}
                      class="case-study-content-wrap w-inline-block"
                    >
                      <div class="case-study-featured-content-top">
                        <div class="case-study-title">{storyTitle}</div>
                      </div>
                      <div class="case-study-item-cta">{t(locale, 'CustomerStories.readStory')}</div>
                    </a>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
