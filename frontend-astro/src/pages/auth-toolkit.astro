---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import AuthToolkitPage from '@/components/pages/AuthToolkitPage.astro';

const locale = 'en';
const title = t(locale, 'AuthToolkit.title');
const description = t(locale, 'AuthToolkit.description');
---

<BaseLayout locale={locale} title={title} description={description}>
  <AuthToolkitPage locale={locale} />
</BaseLayout>
