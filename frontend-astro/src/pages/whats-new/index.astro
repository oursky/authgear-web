---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';
const slugOf = (id: string) => id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');

const entries = (
  await getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft)
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const title = t(locale, 'WhatsNew.title') + ' - Authgear';
const description = t(locale, 'WhatsNew.subtitle');
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero">
          <div class="whats-new-index__hero-body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'WhatsNew.title')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'WhatsNew.title')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'WhatsNew.subtitle')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      {entries.length === 0 ? (
        <p class="whats-new-empty">{t(locale, 'WhatsNew.noUpdatesYet')}</p>
      ) : (
        <ul role="list" class="whats-new-grid">
          {entries.map((entry) => {
            const slug = slugOf(entry.id);
            const date = entry.data.publishedAt.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <li class="whats-new-grid__item">
                <a href={localizedPath(locale, `/whats-new/${slug}`)} class="whats-new-card">
                  <div class="whats-new-card__media">
                    <Image
                      src={entry.data.coverImage}
                      alt={entry.data.title}
                      width={900}
                      loading="lazy"
                      class="whats-new-card__img"
                    />
                  </div>
                  <div class="whats-new-card__body">
                    <div class="whats-new-card__meta">
                      <span class="whats-new-card__category">New Feature</span>
                      <span class="whats-new-card__date">Published on {date}</span>
                    </div>
                    <h3 class="whats-new-card__title">{entry.data.title}</h3>
                    {entry.data.excerpt && <p class="whats-new-card__excerpt">{entry.data.excerpt}</p>}
                    <span class="whats-new-card__cta">
                      Learn More
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
