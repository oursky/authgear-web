---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';
const slugOf = (id: string) => id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');

const entries = (
  await getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft)
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const title = t(locale, 'WhatsNew.title') + ' - Authgear';
const description = t(locale, 'WhatsNew.subtitle');
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="page-wrapper">
    <div class="section whats-new">
      <div class="container-default w-container">
        <h1 class="heading">{t(locale, 'WhatsNew.title')}</h1>
        <p class="paragraph">{t(locale, 'WhatsNew.subtitle')}</p>

        {entries.length === 0 ? (
          <div class="empty-state w-dyn-empty">
            <div>{t(locale, 'WhatsNew.noUpdatesYet')}</div>
          </div>
        ) : (
          <div role="list" class="whats-new-list w-dyn-items">
            {entries.map((entry) => {
              const slug = slugOf(entry.id);
              const date = entry.data.publishedAt.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              });
              return (
                <div role="listitem" class="whats-new-item w-dyn-item">
                  <a href={localizedPath(locale, `/whats-new/${slug}`)} class="card whats-new w-inline-block">
                    <Image
                      src={entry.data.coverImage}
                      alt={entry.data.title}
                      width={900}
                      loading="lazy"
                      style="width: 100%; height: auto;"
                    />
                    <div class="whats-new-content">
                      <div class="whats-new-date">{date}</div>
                      <h3>{entry.data.title}</h3>
                      {entry.data.excerpt && <p class="paragraph-small">{entry.data.excerpt}</p>}
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
