---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '') },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'whats-new'> }

const locale = 'en';
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const date = data.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} title={data.title} description={data.excerpt ?? ''}>
  <div class="page-wrapper">
    <div class="section whats-new-post">
      <div class="container-default w-container">
        <div class="whats-new-date">{date}</div>
        <h1>{data.title}</h1>
        <Image
          src={data.coverImage}
          alt={data.title}
          width={1200}
          loading="eager"
          style="width: 100%; height: auto;"
        />
        <div class="ds-richtext-prose whats-new-rich-text w-richtext">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
