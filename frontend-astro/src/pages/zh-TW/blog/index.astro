---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath, pathLocaleToStrapiLocale } from '@/lib/i18n';
import { BLOG_LIST_PAGE_SIZE, getBlogCategories, getBlogPostsSlice } from '@/lib/strapi';
import { BlogPostInfiniteGrid } from '@/components/islands/blog/BlogPostInfiniteGrid';

const locale = 'zh-TW';
const strapiLocale = pathLocaleToStrapiLocale(locale);

const [{ data: posts, hasMore }, catsRes] = await Promise.all([
  getBlogPostsSlice(strapiLocale, 0, BLOG_LIST_PAGE_SIZE),
  getBlogCategories({ locale: strapiLocale }),
]);

const categories = catsRes.data ?? [];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const title = 'Blog - Resource Center';
const description = 'Stay updated with the latest best practices, product updates, and expert tips on building secure, seamless user experiences with Authgear.';
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="page-wrapper">
    <div class="section blog-gallery">
      <div class="container-default blog-gallery-feature w-container">
        <h1 class="blog-gallery-h1">{t(locale, 'Blog.title')}</h1>
        <div class="text-block-83">
          {t(locale, 'Blog.subtitle')}
        </div>
      </div>
    </div>

    <div class="section all-posts">
      <div class="container-default w-container">
        <div class="top-content latest-posts">
          <div class="split-content top-latest-posts-left">
            <h2 class="heading-32">{t(locale, 'Blog.allPosts')}</h2>
          </div>
          <div class="split-content top-latest-posts-left">
            <a href={localizedPath(locale, '/blog')} class="button-blog-category all w-button w--current">
              {t(locale, 'Blog.all')}
            </a>
            {categories.map((cat) => (
              <a
                href={localizedPath(locale, `/blog?category=${cat.attributes.slug}`)}
                class="button-blog-category w-button"
              >
                {cat.attributes.name}
              </a>
            ))}
          </div>
        </div>

        {posts.length === 0 ? (
          <div class="empty-state w-dyn-empty">
            <div>{t(locale, 'Blog.noPostsYet')}</div>
          </div>
        ) : (
          <BlogPostInfiniteGrid client:visible initialPosts={posts} initialHasMore={hasMore} locale={locale} />
        )}
      </div>
    </div>
  </div>
</BaseLayout>
