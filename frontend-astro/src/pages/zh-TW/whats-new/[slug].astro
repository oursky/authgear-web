---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const [zhEntries, enEntries] = await Promise.all([
    getCollection('whats-new', ({ id, data }) => id.startsWith('zh-TW/') && !data.draft),
    getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft),
  ]);
  const slugOf = (id: string) => id.replace(/^(zh-TW|en)\//, '').replace(/\/index(\.(md|mdx))?$/, '');
  const zhSlugs = new Set(zhEntries.map((e) => slugOf(e.id)));
  const merged = [
    ...zhEntries,
    ...enEntries.filter((e) => !zhSlugs.has(slugOf(e.id))),
  ];
  return merged.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'whats-new'> }

const locale = 'zh-TW';
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const date = data.publishedAt.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} title={data.title} description={data.excerpt ?? ''}>
  <div class="page-wrapper">
    <div class="section whats-new-post">
      <div class="container-default w-container">
        <div class="whats-new-date">{date}</div>
        <h1>{data.title}</h1>
        <Image
          src={data.coverImage}
          alt={data.title}
          width={1200}
          loading="eager"
          style="width: 100%; height: auto;"
        />
        <div class="ds-richtext-prose whats-new-rich-text w-richtext">
          <Content />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
