---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';
const slugOf = (id: string) => id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');

const entries = (await getCollection('integrations', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

// Resolve category names per entry.
const enriched = await Promise.all(entries.map(async (e) => {
  let categoryName: string | undefined;
  if (e.data.category) {
    const cat = await getEntry('integration-categories', e.data.category);
    categoryName = cat?.data.name;
  }
  return { entry: e, slug: slugOf(e.id), categoryName };
}));

const title = '3rd Party Integrations - Authgear';
const description = 'Authgear connects with the tools you already use for marketing, operations, productivity, and communication.';
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero integrations-index__hero">
          <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">Integrations</p>
          <h1 class="ds-hero-banner__title">Integrations</h1>
          <p class="ds-hero-banner__description">
            Authgear connects with the tools you already use — for marketing, operations, productivity, and communication.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      <ul role="list" class="integrations-grid">
        {enriched.map(({ entry, slug, categoryName }) => (
          <li class="integrations-grid__item">
            <a href={localizedPath(locale, `/integrations/${slug}`)} class="integration-card">
              <div class="integration-card__icon">
                <Image src={entry.data.icon} alt={entry.data.name} width={80} loading="lazy" />
              </div>
              <h3 class="integration-card__name">{entry.data.name}</h3>
              {categoryName && <p class="integration-card__category">{categoryName}</p>}
              <p class="integration-card__excerpt">{entry.data.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
