---
export const prerender = true;

import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogHero from '@/components/blog/BlogHero.astro';
import BlogCategoryNav from '@/components/blog/BlogCategoryNav.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import BlogPagination from '@/components/blog/BlogPagination.astro';
import { t } from '@/i18n';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [categories, allPosts] = await Promise.all([
    getCollection('blog-categories'),
    getCollection('blog-posts', ({ id, data }) => id.startsWith('en/') && !data.draft),
  ]);

  const sortedPosts = allPosts.sort((a, b) => {
    const aD = (a.data.publishedAtOverride ?? a.data.publishedAt).getTime();
    const bD = (b.data.publishedAtOverride ?? b.data.publishedAt).getTime();
    return bD - aD;
  });

  return categories.flatMap((cat) => {
    const filtered = sortedPosts.filter((p) => p.data.category === cat.data.slug);
    return paginate(filtered, {
      pageSize: 24,
      params: { slug: cat.data.slug },
      props: { categoryName: cat.data.name, categorySlug: cat.data.slug },
    });
  });
}

interface Props {
  page: Page<CollectionEntry<'blog-posts'>>;
  categoryName: string;
  categorySlug: string;
}

const locale = 'en';
const { page, categoryName, categorySlug } = Astro.props;

const title = `${categoryName} - ${t(locale, 'Blog.title')} - Authgear`;
const description = t(locale, 'Blog.subtitle');
---

<BaseLayout locale={locale} title={title} description={description}>
  <BlogHero
    title={categoryName}
    subtitle={t(locale, 'Blog.subtitle')}
    eyebrow={t(locale, 'Blog.title')}
  />

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      <BlogCategoryNav locale={locale} currentCategory={categorySlug} />

      {page.data.length === 0 ? (
        <p class="blog-empty">{t(locale, 'Blog.noPostsYet')}</p>
      ) : (
        <div class="blog-grid">
          {page.data.map((entry) => (
            <BlogCard entry={entry} locale={locale} />
          ))}
        </div>
      )}

      <BlogPagination page={page} locale={locale} />
    </div>
  </section>
</BaseLayout>
