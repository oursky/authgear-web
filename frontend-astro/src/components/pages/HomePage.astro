---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import ContactForm from '@/components/islands/ContactForm';
import LogoMarquee from '@/components/islands/LogoMarquee';

interface Props { locale: string }
const { locale } = Astro.props;

function tRich(locale: string, key: string): string {
  const raw = t(locale, key);
  return raw
    .replace(/<gradient>([\s\S]*?)<\/gradient>/g, '<span class="once-gradient">$1</span>')
    .replace(/<br><\/br>/g, '<br>')
    .replace(/<br\s*\/>/g, '<br>');
}
