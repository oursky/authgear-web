---
interface Props { locale: string }
const { locale } = Astro.props;

const WHY_CARDS = [
  {
    img: '/images/features-otp-whyotp-01.svg',
    title: 'Cut OTP costs in many markets',
    desc: "WhatsApp's messaging pricing for authentication can be markedly cheaper than SMS depending on the country. Up to 80% cost saving.",
  },
  {
    img: '/images/features-otp-whyotp-02.svg',
    title: 'More private by design',
    desc: "WhatsApp uses end-to-end encryption so only the intended user can read the OTP, unlike SMS, which isn't E2E encrypted.",
  },
  {
    img: '/images/features-otp-whyotp-03.svg',
    title: 'Reach users where they already are',
    desc: 'WhatsApp is the world\'s most popular messenger with ~2.9B monthly users, and 100M+ in the U.S. alone. So your OTPs land in a familiar, high-engagement channel.',
  },
  {
    img: '/images/features-otp-whyotp-04.svg',
    title: 'Works even without cellular service',
    desc: 'OTPs deliver over any internet connection, so users can authenticate even when they have no cell signal.',
  },
] as const;

const HOW_STEPS = [
  { img: '/images/features-otp-howitworks-phonenumber.svg', step: 'User enters their phone number' },
  { img: '/images/features-otp-howitworks-otp.svg', step: 'Authgear issues a one-time code to their WhatsApp' },
  { img: '/images/features-otp-howitworks-submitcode.svg', step: 'User submits the code and is securely signed in' },
] as const;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">WhatsApp OTP</p>
            <h1 class="ds-hero-banner__title">Authentication users with WhatsApp OTPs</h1>
            <p class="ds-hero-banner__description">Enable your users to login securely with the chat app they love.</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-whatsapp-otp&amp;utm_medium=link&amp;utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                Start for Free
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                Get a Demo
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                Free plan includes <strong>unlimited MAUs</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-whatsappotp-hero-banner2x.png"
            srcset="/images/features-whatsappotp-hero-banner2x-p-500.png 500w, /images/features-whatsappotp-hero-banner2x-p-800.png 800w, /images/features-whatsappotp-hero-banner2x-p-1080.png 1080w, /images/features-whatsappotp-hero-banner2x.png 1459w"
            sizes="(max-width: 767px) 100vw, 738px"
            width={738}
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">Why WhatsApp OTP with Authgear</h2>
      <p class="section-lede-on-light">Lower-cost, secure OTP delivery on the messaging app users already trust.</p>
    </div>
    <div class="ds-grid-2">
      {WHY_CARDS.map((card) => (
        <div class="svg-card">
          <div class="svg-card-image-container">
            <img src={card.img} loading="lazy" alt="" />
          </div>
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{card.title}</div>
            <div class="ds-svg-card-description">{card.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="ds-section ds-bg-white">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">How It Works</h2>
    </div>
    <div class="ds-grid-3 whatsapp-otp-how-grid">
      {HOW_STEPS.map((s) => (
        <div class="whatsapp-otp-how-step">
          <div class="whatsapp-otp-how-step__figure">
            <img src={s.img} loading="lazy" alt="" class="whatsapp-otp-how-step__img" />
          </div>
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{s.step}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="whatsapp-otp-checks">
      <ul role="list" class="whatsapp-otp-checks__list">
        <li>
          Authgear enforces <strong>rate limits, account lockout, and bot protection (CAPTCHA)</strong> to keep OTP flows safe and abuse-resistant.
        </li>
        <li>Authgear also supports multi-channel fallback, e.g., try WhatsApp first, then SMS. so you never strand a user.</li>
      </ul>
    </div>
  </div>
</section>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">Ready to reduce costs and boost verification rates?Let's ship WhatsApp OTP with Authgear</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-whatsapp-otp&amp;utm_medium=link&amp;utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        Start for Free
      </a>
      <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        Get a Demo
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        Free plan includes <strong>unlimited MAUs</strong>
      </p>
    </div>
  </div>
</section>
