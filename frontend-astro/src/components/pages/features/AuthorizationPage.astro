---
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">Authorization</p>
            <h1 class="ds-hero-banner__title">Authorization and access management</h1>
            <p class="ds-hero-banner__description">Fine-grained access control built for your users, teams and products</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-authorization&amp;utm_medium=link&amp;utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                Start for Free
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                Get a Demo
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                Free plan includes <strong>unlimited MAUs</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-authorization-hero-banner2x.webp"
            srcset="/images/features-authorization-hero-banner2x-p-500.webp 500w, /images/features-authorization-hero-banner2x-p-800.webp 800w, /images/features-authorization-hero-banner2x-p-1080.webp 1080w, /images/features-authorization-hero-banner2x.webp 1244w"
            sizes="(max-width: 767px) 100vw, 738px"
            width={738}
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>
<section class="ds-section">
  <div class="ds-container">
    <div class="ds-feature-callout">
      <div class="ds-feature-callout__title">
        <h2 class="heading-on-dark">
          Why<br />
          Authgear
        </h2>
      </div>
      <div class="ds-feature-callout__body">
        <p class="section-lede-on-dark">
          With growing user bases and complex apps, managing who can do what is critical.<br />
          Roles &amp; Groups let you shift from per-user permissions to a scalable model where you manage roles once, then assign at scale.
        </p>
        <div class="ds-feature-callout__ctas">
          <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-primary">
            Talk to us
          </a>
          <a
            href="https://accounts.portal.authgear.com/signup"
            target="_blank"
            rel="noreferrer"
            class="ds-btn ds-btn-outline-light"
          >
            Start for Free
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="ds-section ds-bg-light-blue">
  <div class="ds-container ds-container--split-stack ds-container--split-stack--title-gap-m">
    <div class="title-content">
      <h2 class="heading-on-light">Centralized Authorization with Roles and Groups</h2>
    </div>
    <div class="ds-split-stack__rows">
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img
            src="/images/features-authorization-content-roles.svg"
            loading="lazy"
            width={624}
            alt=""
            class="ds-split-row__img"
          />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">Roles</h3>
          <p class="section-lede-on-light">Define roles and assign roles to users directly. Roles are included in UserInfo / JWT claims so your app has the context to enforce permissions.</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img
            src="/images/features-authorization-content-groups.svg"
            loading="lazy"
            width={624}
            alt=""
            class="ds-split-row__img"
          />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">Groups</h3>
          <p class="section-lede-on-light">Create groups that bundle one or more roles. Add users to groups; they inherit the roles of that group. Simplifies bulk-permission management.</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img
            src="/images/features-authorization-content-audit.svg"
            loading="lazy"
            width={624}
            alt=""
            class="ds-split-row__img"
          />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">Audit-ready</h3>
          <p class="section-lede-on-light">Manage roles/groups and see who has what role in a central place. Position for governance, compliance and least-privilege access as you scale.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">Ready to simplify access control and scale your authorization model?</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-authorization&amp;utm_medium=link&amp;utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        Start for Free
      </a>
      <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        Get a Demo
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        Free plan includes <strong>unlimited MAUs</strong>
      </p>
    </div>
  </div>
</section>
