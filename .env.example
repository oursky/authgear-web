# Optional: contact form webhook.
# POST /api/contact forwards submissions here as JSON. Leave blank to only
# log submissions to stdout (fine for local dev).
CONTACT_WEBHOOK_URL=

# Optional: Google Tag Manager container ID (e.g. "GTM-XXXXXXX").
# The GTM script and noscript iframe only load when this is set, so leave
# blank locally and in staging to avoid firing into the production GTM
# container. In production, set this to the container ID you want to load.
PUBLIC_GTM_ID=

# Optional: Plausible analytics site identifier.
# This is the string you registered in your Plausible dashboard (a label,
# not a runtime hostname check) — conventionally the canonical production
# domain, e.g. "authgear.com". The Plausible script only loads when this
# is set, so leave blank locally and in staging to avoid polluting prod
# analytics. Register a separate Plausible site if you want staging stats.
PUBLIC_PLAUSIBLE_DOMAIN=
