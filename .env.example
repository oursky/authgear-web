# ═══════════════════════════════════════════════════════════════════════════════
# Strapi Cloud (default for Docker Compose in this repo)
# ═══════════════════════════════════════════════════════════════════════════════
# From Strapi Cloud dashboard: your project API URL (same value for both is typical).
# Example: https://your-project.strapiapp.com
STRAPI_URL=
NEXT_PUBLIC_STRAPI_URL=

# Read-only API token: Strapi Admin → Settings → API Tokens (on your Cloud project)
STRAPI_API_TOKEN=

# Optional: contact form webhook
CONTACT_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════════════
# Self-hosted Strapi only — used with:
#   docker compose -f docker-compose.selfhosted.yml up --build -d
# ═══════════════════════════════════════════════════════════════════════════════
POSTGRES_PASSWORD=change_me_in_production

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=change_me
STRAPI_ADMIN_JWT_SECRET=change_me
STRAPI_TRANSFER_TOKEN_SALT=change_me
STRAPI_JWT_SECRET=change_me
STRAPI_ENCRYPTION_KEY=change_me
