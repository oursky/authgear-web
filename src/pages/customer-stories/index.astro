---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';
const entries = (await getCollection('customer-stories', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => {
    const orderA = a.data.order ?? Number.POSITIVE_INFINITY;
    const orderB = b.data.order ?? Number.POSITIVE_INFINITY;
    if (orderA !== orderB) return orderA - orderB;
    return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  });

const title = 'Customer Stories - Authgear';
const description = t(locale, 'CustomerStories.subtitle');
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="page-wrapper">
    <section class="ds-section ds-bg-white ds-customer-stories-index">
      <header class="ds-customer-stories-index__header">
        <div class="ds-container">
          <div class="title-content">
            <h1 class="heading-on-light">{t(locale, 'CustomerStories.title')}</h1>
            <p class="section-lede-on-light">{t(locale, 'CustomerStories.subtitle')}</p>
          </div>
        </div>
      </header>

      <div class="ds-customer-stories-index__main">
        <div class="ds-container">
          {entries.length === 0 ? (
            <div class="empty-state w-dyn-empty">
              <div>{t(locale, 'CustomerStories.noStoriesYet')}</div>
            </div>
          ) : (
            <div role="list" class="case-study-list">
              {entries.map((entry) => {
                const slug = entry.id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');
                return (
                  <div role="listitem" class="case-study-item-wrap">
                    <a
                      href={localizedPath(locale, `/customer-stories/${slug}`)}
                      class="case-study-featured-image-wrap w-inline-block"
                    >
                      <Image
                        src={entry.data.thumbnail}
                        alt={entry.data.title}
                        width={600}
                        class="case-study-featured-image"
                        style="object-fit: cover; width: 100%; height: auto;"
                        loading="lazy"
                      />
                    </a>
                    <a
                      href={localizedPath(locale, `/customer-stories/${slug}`)}
                      class="case-study-content-wrap w-inline-block"
                    >
                      <div class="case-study-featured-content-top">
                        <div class="case-study-title">{entry.data.title}</div>
                      </div>
                      <div class="case-study-item-cta">{t(locale, 'CustomerStories.readStory')}</div>
                    </a>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
