---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localizedPath } from '@/lib/i18n';

const locale = 'zh-Hant';
const slugOf = (id: string) => id.replace(/^(zh-Hant|en)\//, '').replace(/\/index(\.(md|mdx))?$/, '');

const [zhEntries, enEntries] = await Promise.all([
  getCollection('integrations', ({ id }) => id.startsWith('zh-Hant/')),
  getCollection('integrations', ({ id }) => id.startsWith('en/')),
]);
const zhSlugs = new Set(zhEntries.map((e) => slugOf(e.id)));
const merged = [
  ...zhEntries,
  ...enEntries.filter((e) => !zhSlugs.has(slugOf(e.id))),
].sort((a, b) => a.data.name.localeCompare(b.data.name));

const enriched = await Promise.all(merged.map(async (e) => {
  let categoryName: string | undefined;
  if (e.data.category) {
    const cat = await getEntry('integration-categories', e.data.category);
    categoryName = cat?.data.name;
  }
  return { entry: e, slug: slugOf(e.id), categoryName };
}));

const title = '第三方整合 - Authgear';
const description = 'Authgear 支援與行銷、營運、生產力與通訊工具無縫整合。';
---

<BaseLayout locale={locale} title={title} description={description}>
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero integrations-index__hero">
          <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">第三方整合</p>
          <h1 class="ds-hero-banner__title">第三方整合</h1>
          <p class="ds-hero-banner__description">
            Authgear 支援與行銷、營運、生產力與通訊工具無縫整合。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      <ul role="list" class="integrations-grid">
        {enriched.map(({ entry, slug, categoryName }) => (
          <li class="integrations-grid__item">
            <a href={localizedPath(locale, `/integrations/${slug}`)} class="integration-card">
              <div class="integration-card__icon">
                <Image src={entry.data.icon} alt={entry.data.name} width={80} loading="lazy" />
              </div>
              <h3 class="integration-card__name">{entry.data.name}</h3>
              {categoryName && <p class="integration-card__category">{categoryName}</p>}
              <p class="integration-card__excerpt">{entry.data.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
