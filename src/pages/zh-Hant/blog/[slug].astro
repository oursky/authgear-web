---
export const prerender = true;

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const [zhEntries, enEntries] = await Promise.all([
    getCollection('blog-posts', ({ id, data }) => id.startsWith('zh-Hant/') && !data.draft),
    getCollection('blog-posts', ({ id, data }) => id.startsWith('en/') && !data.draft),
  ]);
  const slugOf = (id: string) => id.replace(/^(zh-Hant|en)\//, '').replace(/\/index(\.(md|mdx))?$/, '');
  const zhSlugs = new Set(zhEntries.map((e) => slugOf(e.id)));
  const merged = [
    ...zhEntries,
    ...enEntries.filter((e) => !zhSlugs.has(slugOf(e.id))),
  ];
  return merged.map((entry) => ({ params: { slug: slugOf(entry.id) } }));
}

const { slug } = Astro.params as { slug: string };
return Astro.redirect(`/zh-Hant/post/${slug}`, 301);
---
