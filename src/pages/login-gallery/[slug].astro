---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LoginGallerySidebar from '@/components/login-gallery/LoginGallerySidebar.astro';
import LoginGalleryCarousel from '@/components/islands/login-gallery/LoginGalleryCarousel';
import { t as tFn } from '@/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('login-gallery', ({ id, data }) => id.startsWith('en/') && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '') },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'login-gallery'> }

const locale = 'en';
const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

async function slidesFor(images: readonly (typeof data.mainImage)[]) {
  const out: { src: string; alt: string }[] = [];
  for (const img of images) {
    const optimized = await getImage({ src: img, width: 1200 });
    out.push({ src: optimized.src, alt: data.title });
  }
  return out;
}

const mainSlide = [{
  src: (await getImage({ src: data.mainImage, width: 1200 })).src,
  alt: data.title,
}];
const webRaw = await slidesFor(data.webSlides);
const mobileRaw = await slidesFor(data.mobileSlides);
const webSlides = webRaw.length > 0 ? webRaw : mainSlide;
const mobileSlides = mobileRaw.length > 0 ? mobileRaw : (webRaw.length === 0 ? mainSlide : []);

const t = (k: string) => tFn(locale, `LoginGalleryDetail.${k}`);
const sidebarLabels = {
  industry: t('sidebarIndustry'),
  loginMethods: t('sidebarLoginMethods'),
  socialLogin: t('sidebarSocialLogin'),
  technicalDetails: t('sidebarTechnicalDetails'),
};
const carouselLabels = {
  web: t('web'),
  mobile: t('mobile'),
  platformPickerAria: t('platformPickerAria'),
  prevSlide: t('prevSlide'),
  nextSlide: t('nextSlide'),
  goToSlide: t('goToSlide'),
};
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={tFn(locale, 'LoginGallery.detailDescription').replace('{title}', data.title)}
>
  <section class="ds-section ds-login-gallery-page">
    <header class="ds-login-gallery-page__header">
      <div class="ds-container ds-login-gallery-page__container">
        <a href="/login-gallery" class="ds-login-gallery-page__eyebrow ds-section-eyebrow ds-section-eyebrow--on-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width={18} height={18} viewBox="0 0 18 18" fill="none" aria-hidden>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.57063 9C5.57063 8.78055 5.65463 8.56118 5.82173 8.394L10.9644 3.25135C11.2996 2.91622 11.8413 2.91622 12.1764 3.25135C12.5115 3.58648 12.5115 4.12817 12.1764 4.4633L7.63973 9L12.1764 13.5367C12.5115 13.8719 12.5115 14.4135 12.1764 14.7487C11.8413 15.0838 11.2996 15.0838 10.9644 14.7487L5.82173 9.606C5.65463 9.43883 5.57063 9.21945 5.57063 9Z" fill="currentColor" />
          </svg>
          {t('eyebrow')}
        </a>
        <h1 class="ds-login-gallery-page__title">{data.title}</h1>
      </div>
    </header>

    <div class="ds-login-gallery-page__carousel">
      <div class="ds-container ds-login-gallery-page__container">
        <LoginGalleryCarousel
          client:load
          webSlides={webSlides}
          mobileSlides={mobileSlides}
          title={data.title}
          labels={carouselLabels}
        />
      </div>
    </div>

    <div class="ds-login-gallery-page__content ds-login-gallery-page__content--split">
      <div class="ds-container ds-login-gallery-page__container">
        <div class="ds-login-gallery-body">
          <div class="ds-login-gallery-body__main">
            <div class="ds-richtext-prose ds-richtext-prose--on-dark ds-login-gallery-richtext">
              <Content />
            </div>
          </div>
          <LoginGallerySidebar
            industry={data.industry}
            loginMethods={data.loginMethods}
            socialLogins={data.socialLogins}
            technicalDetails={data.technicalDetails}
            labels={sidebarLabels}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
