---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

const locale = 'en';

const entries = (
  await getCollection('login-gallery', ({ id, data }) => id.startsWith('en/') && !data.draft)
).sort((a, b) => {
  const orderA = a.data.order ?? Number.POSITIVE_INFINITY;
  const orderB = b.data.order ?? Number.POSITIVE_INFINITY;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
});

const title = t(locale, 'LoginGalleryIndex.metaTitle');
const description = t(locale, 'LoginGalleryIndex.metaDescription');
const GET_STARTED_URL = 'https://portal.authgear.com/?utm_source=login-gallery&utm_medium=link&utm_campaign=start-for-free';
const DOCS_URL = 'https://docs.authgear.com/?utm_source=login-gallery&utm_medium=link&utm_campaign=dev-docs';

const slugOf = (id: string) => id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');
---

<BaseLayout locale={locale} title={title} description={description}>
  <div class="page-wrapper">
    <section class="ds-section ds-login-gallery-index">
      <div class="ds-login-gallery-index__hero">
        <div class="ds-container ds-container--hero">
          <div class="ds-login-gallery-index__hero-inner">
            <p class="ds-login-gallery-index__eyebrow">{t(locale, 'LoginGalleryIndex.eyebrow')}</p>
            <h1 class="ds-login-gallery-index__hero-title">
              <span class="ds-login-gallery-index__hero-title-line">{t(locale, 'LoginGalleryIndex.heroTitleLine1')}</span>
              <span class="ds-login-gallery-index__hero-title-line">{t(locale, 'LoginGalleryIndex.heroTitleLine2')}</span>
            </h1>
            <p class="ds-login-gallery-index__hero-lede">{t(locale, 'LoginGalleryIndex.heroSubtitle')}</p>
            <div class="ds-login-gallery-index__hero-actions">
              <a href={GET_STARTED_URL} target="_blank" rel="noreferrer" class="ds-btn ds-btn-primary">
                {t(locale, 'LoginGalleryIndex.ctaPrimary')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={DOCS_URL} target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'LoginGalleryIndex.ctaDocs')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="ds-login-gallery-index__grid-section">
        <div class="ds-container">
          {entries.length === 0 ? (
            <p class="ds-login-gallery-index__empty">{t(locale, 'LoginGalleryIndex.emptyState')}</p>
          ) : (
            <ul class="ds-login-gallery-index__grid" role="list">
              {entries.map((entry) => {
                const slug = slugOf(entry.id);
                const href = localizedPath(locale, `/login-gallery/${slug}`);
                return (
                  <li class="ds-login-gallery-index__grid-item">
                    <a href={href} class="ds-login-gallery-index-card" aria-label={entry.data.title}>
                      <div class="ds-login-gallery-index-card__frame">
                        <div class="ds-login-gallery-index-card__media">
                          <Image
                            src={entry.data.mainImage}
                            alt=""
                            loading="lazy"
                            class="ds-login-gallery-index-card__img"
                            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
                          />
                        </div>
                      </div>
                      <h3 class="ds-login-gallery-index-card__title">{entry.data.title}</h3>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
