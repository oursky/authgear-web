---
export const prerender = true;
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import SecurityPage from '@/components/pages/SecurityPage.astro';

const locale = 'zh-TW';
const title = t(locale, 'Security.title');
const description = t(locale, 'Security.description');
---

<BaseLayout locale={locale} title={title} description={description}>
  <SecurityPage locale={locale} />
</BaseLayout>
