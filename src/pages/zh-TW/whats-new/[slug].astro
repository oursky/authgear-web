---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

export async function getStaticPaths() {
  const [zhEntries, enEntries] = await Promise.all([
    getCollection('whats-new', ({ id, data }) => id.startsWith('zh-TW/') && !data.draft),
    getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft),
  ]);
  const slugOf = (id: string) => id.replace(/^(zh-TW|en)\//, '').replace(/\/index(\.(md|mdx))?$/, '');
  const zhSlugs = new Set(zhEntries.map((e) => slugOf(e.id)));
  const merged = [
    ...zhEntries,
    ...enEntries.filter((e) => !zhSlugs.has(slugOf(e.id))),
  ];
  return merged.map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'whats-new'> }

const locale = 'zh-TW';
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const date = data.publishedAt.toLocaleDateString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} title={data.title} description={data.excerpt ?? ''}>
  <article class="whats-new-post">
    <header class="whats-new-post__header">
      <div class="ds-container">
        <a href={localizedPath(locale, '/whats-new')} class="whats-new-post__back">
          ← {t(locale, 'WhatsNew.title')}
        </a>
        <p class="whats-new-post__date">{date}</p>
        <h1 class="whats-new-post__title">{data.title}</h1>
        {data.excerpt && <p class="whats-new-post__excerpt">{data.excerpt}</p>}
      </div>
    </header>

    <div class="whats-new-post__cover">
      <div class="ds-container">
        <Image
          src={data.coverImage}
          alt={data.title}
          width={1200}
          loading="eager"
          class="whats-new-post__cover-img"
        />
      </div>
    </div>

    <div class="ds-section ds-bg-white">
      <div class="ds-container">
        <div class="whats-new-post__body ds-richtext-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
