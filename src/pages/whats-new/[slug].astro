---
export const prerender = true;

import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('whats-new', ({ id, data }) => id.startsWith('en/') && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '') },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'whats-new'> }

const locale = 'en';
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const date = data.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} title={data.title} description={data.excerpt ?? ''}>
  <article class="whats-new-post">
    <header class="whats-new-post__header">
      <div class="ds-container">
        <a href={localizedPath(locale, '/whats-new')} class="whats-new-post__back">
          ← {t(locale, 'WhatsNew.title')}
        </a>
        <p class="whats-new-post__date">{date}</p>
        <h1 class="whats-new-post__title">{data.title}</h1>
        {data.excerpt && <p class="whats-new-post__excerpt">{data.excerpt}</p>}
      </div>
    </header>

    <div class="whats-new-post__cover">
      <div class="ds-container">
        <Image
          src={data.coverImage}
          alt={data.title}
          width={1200}
          loading="eager"
          class="whats-new-post__cover-img"
        />
      </div>
    </div>

    <div class="ds-section ds-bg-white">
      <div class="ds-container">
        <div class="whats-new-post__body ds-richtext-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
