---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  companyLogo?: ImageMetadata;
  companyLogoAlt: string;
  companyIndustry?: string;
  loginMethods: readonly string[];
  technicalDetails: readonly string[];
  labels: {
    industry: string;
    loginMethods: string;
    technicalDetails: string;
  };
  downloadCta?: { href: string; alt: string };
}

const EMPTY = '—';
const {
  companyLogo,
  companyLogoAlt,
  companyIndustry,
  loginMethods,
  technicalDetails,
  labels,
  downloadCta,
} = Astro.props;
const industryText = companyIndustry?.trim() || '';
---
<aside class="ds-customer-story-body__sidebar">
  {companyLogo && (
    <div class="ds-customer-story-body__logo-wrap">
      <Image
        src={companyLogo}
        alt={companyLogoAlt}
        width={180}
        class="ds-customer-story-body__logo"
        loading="lazy"
      />
    </div>
  )}
  <dl class="ds-customer-story-body__meta-list">
    <div class="ds-customer-story-body__meta">
      <dt class="ds-customer-story-body__label">{labels.industry}</dt>
      <dd class="ds-customer-story-body__dd ds-customer-story-body__value">
        {industryText || EMPTY}
      </dd>
    </div>
    <div class="ds-customer-story-body__meta">
      <dt class="ds-customer-story-body__label">{labels.loginMethods}</dt>
      <dd class="ds-customer-story-body__dd">
        {loginMethods.length > 0 ? (
          <ul class="ds-customer-story-body__chip-list">
            {loginMethods.map((item) => (
              <li class="ds-customer-story-body__chip">{item}</li>
            ))}
          </ul>
        ) : (
          <span class="ds-customer-story-body__value ds-customer-story-body__value--plain">{EMPTY}</span>
        )}
      </dd>
    </div>
    <div class="ds-customer-story-body__meta">
      <dt class="ds-customer-story-body__label">{labels.technicalDetails}</dt>
      <dd class="ds-customer-story-body__dd">
        {technicalDetails.length > 0 ? (
          <ul class="ds-customer-story-body__chip-list">
            {technicalDetails.map((item) => (
              <li class="ds-customer-story-body__chip">{item}</li>
            ))}
          </ul>
        ) : (
          <span class="ds-customer-story-body__value ds-customer-story-body__value--plain">{EMPTY}</span>
        )}
      </dd>
    </div>
  </dl>
  {downloadCta && (
    <a
      href={downloadCta.href}
      class="ds-customer-story-cta"
      aria-label={downloadCta.alt}
    >
      <img
        src="/images/case-study-download2x.jpg"
        srcset="/images/case-study-download2x-p-500.jpg 500w, /images/case-study-download2x.jpg 1000w"
        sizes="(max-width: 991px) 100vw, 280px"
        alt={downloadCta.alt}
        loading="lazy"
      />
    </a>
  )}
</aside>
