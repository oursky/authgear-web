---
/**
 * Boots the Lottie player for every `[data-animation-type="lottie"]` element on
 * the page. Drop this once into any page component that has such an element —
 * Astro hoists and dedupes the script, and the player bundle itself is only
 * fetched when an animation scrolls into view.
 */
---
<script>
  import '@/scripts/lottie';
</script>
