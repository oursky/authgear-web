---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import { pricingCopyEn } from '@/lib/pricing/copy-en';
import { pricingCopyZhHant } from '@/lib/pricing/copy-zh-Hant';
import PricingPageClient from '@/components/islands/pricing/PricingPageClient';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const baseCopy = locale === 'zh-Hant' ? pricingCopyZhHant : pricingCopyEn;
const contactPath = localizedPath(locale, '/schedule-demo');
const whatsappPath = localizedPath(locale, '/features/whatsapp-otp');

const copy = {
  ...baseCopy,
  meta: {
    title: t(locale, 'Pricing.metaTitle'),
    description: t(locale, 'Pricing.metaDescription'),
  },
  tabs: {
    cloud: t(locale, 'Pricing.tabCloud'),
    once: t(locale, 'Pricing.tabOnce'),
  },
  cloud: {
    ...baseCopy.cloud,
    titleLine1: t(locale, 'Pricing.cloudTitleLine1'),
    titleHighlight: t(locale, 'Pricing.cloudTitleHighlight'),
    titleLine2: t(locale, 'Pricing.cloudTitleLine2'),
    subtitle: t(locale, 'Pricing.cloudSubtitle'),
    intro: t(locale, 'Pricing.cloudIntro'),
    introStrong: t(locale, 'Pricing.cloudIntroStrong'),
    introRest: t(locale, 'Pricing.cloudIntroRest'),
    expandComparison: t(locale, 'Pricing.cloudExpandComparison'),
    fullPlanTitle: t(locale, 'Pricing.cloudFullPlanTitle'),
  },
  once: {
    ...baseCopy.once,
    titleLine1: t(locale, 'Pricing.onceTitleLine1'),
    titleHighlight: t(locale, 'Pricing.onceTitleHighlight'),
    titleLine2: t(locale, 'Pricing.onceTitleLine2'),
    subtitle: t(locale, 'Pricing.onceSubtitle'),
    intro: t(locale, 'Pricing.onceIntro'),
    coreTitle: t(locale, 'Pricing.onceCoreTitle'),
    enterpriseContactSuffix: t(locale, 'Pricing.onceEnterpriseContactSuffix'),
  },
  cta: {
    ...baseCopy.cta,
    title: t(locale, 'Pricing.ctaTitle'),
    subtitle: t(locale, 'Pricing.ctaSubtitle'),
    button: t(locale, 'Pricing.ctaButton'),
  },
  faq: {
    ...baseCopy.faq,
    heading: t(locale, 'Pricing.faqHeading'),
  },
};
---

<PricingPageClient
  client:load
  copy={copy}
  locale={locale}
  contactPath={contactPath}
  whatsappPath={whatsappPath}
  month={t(locale, 'Pricing.month')}
  onceSuffix={t(locale, 'Pricing.onceSuffix')}
  enterpriseContactLabel={t(locale, 'Pricing.enterpriseContactLabel')}
/>
