---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import { pricingCopyEn } from '@/lib/pricing/copy-en';
import { pricingCopyZhHant } from '@/lib/pricing/copy-zh-Hant';
import PricingPageClient from '@/components/islands/pricing/PricingPageClient';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const baseCopy = locale === 'zh-Hant' ? pricingCopyZhHant : pricingCopyEn;
const contactPath = localizedPath(locale, '/schedule-demo');
const whatsappPath = localizedPath(locale, '/whatsapp-otp-pricing');

const copy = {
  ...baseCopy,
  meta: {
    title: t(locale, 'Pricing.metaTitle'),
    description: t(locale, 'Pricing.metaDescription'),
  },
  tabs: {
    cloud: t(locale, 'Pricing.tabCloud'),
    once: t(locale, 'Pricing.tabOnce'),
  },
  cloud: {
    ...baseCopy.cloud,
    titleLine1: t(locale, 'Pricing.cloudTitleLine1'),
    titleHighlight: t(locale, 'Pricing.cloudTitleHighlight'),
    titleLine2: t(locale, 'Pricing.cloudTitleLine2'),
    subtitle: t(locale, 'Pricing.cloudSubtitle'),
    intro: t(locale, 'Pricing.cloudIntro'),
    introStrong: t(locale, 'Pricing.cloudIntroStrong'),
    introRest: t(locale, 'Pricing.cloudIntroRest'),
    expandComparison: t(locale, 'Pricing.cloudExpandComparison'),
    fullPlanTitle: t(locale, 'Pricing.cloudFullPlanTitle'),
  },
  once: {
    ...baseCopy.once,
    titleLine1: t(locale, 'Pricing.onceTitleLine1'),
    titleHighlight: t(locale, 'Pricing.onceTitleHighlight'),
    titleLine2: t(locale, 'Pricing.onceTitleLine2'),
    subtitle: t(locale, 'Pricing.onceSubtitle'),
    intro: t(locale, 'Pricing.onceIntro'),
    coreTitle: t(locale, 'Pricing.onceCoreTitle'),
    enterpriseContactSuffix: t(locale, 'Pricing.onceEnterpriseContactSuffix'),
  },
  cta: {
    ...baseCopy.cta,
    title: t(locale, 'Pricing.ctaTitle'),
    subtitle: t(locale, 'Pricing.ctaSubtitle'),
    button: t(locale, 'Pricing.ctaButton'),
  },
  faq: {
    ...baseCopy.faq,
    heading: t(locale, 'Pricing.faqHeading'),
  },
};

const planFinder = {
  heading: t(locale, 'Pricing.planFinderHeading'),
  labelApplications: t(locale, 'Pricing.planFinderApplications'),
  labelProjectMembers: t(locale, 'Pricing.planFinderProjectMembers'),
  labelMaus: t(locale, 'Pricing.planFinderMaus'),
  recommendedHeading: t(locale, 'Pricing.planFinderRecommended'),
  appsTenPlus: t(locale, 'Pricing.planFinderAppsTenPlus'),
  mauThirtyKPlus: t(locale, 'Pricing.planFinderMauThirtyKPlus'),
  mauScaleLast: t(locale, 'Pricing.planFinderMauScaleLast'),
  mauUnlimitedValue: t(locale, 'Pricing.planFinderMauUnlimitedValue'),
  compareTitle: t(locale, 'Pricing.planFinderCompareTitle'),
  compareDisclaimer: t(locale, 'Pricing.planFinderCompareDisclaimer'),
  priceFree: t(locale, 'Pricing.planFinderPriceFree'),
  priceFrom: t(locale, 'Pricing.planFinderPriceFrom'),
  or: t(locale, 'Pricing.planFinderOr'),
  labelSmsWhatsapp: t(locale, 'Pricing.planFinderSmsWhatsapp'),
  labelLogRetention: t(locale, 'Pricing.planFinderLogRetention'),
  logRetention1Day: t(locale, 'Pricing.planFinderLogRetention1Day'),
  logRetention60Days: t(locale, 'Pricing.planFinderLogRetention60Days'),
  logRetention180Days: t(locale, 'Pricing.planFinderLogRetention180Days'),
  toggleYes: t(locale, 'Pricing.planFinderYes'),
  toggleNo: t(locale, 'Pricing.planFinderNo'),
  enterpriseTitle: t(locale, 'Pricing.planFinderEnterpriseTitle'),
  enterpriseBody: t(locale, 'Pricing.planFinderEnterpriseBody'),
  enterpriseFeatures: [
    t(locale, 'Pricing.planFinderEnterpriseFeatureAppsMembers'),
    t(locale, 'Pricing.planFinderEnterpriseFeatureLogRetention'),
    t(locale, 'Pricing.planFinderEnterpriseFeaturePrivateCloud'),
    t(locale, 'Pricing.planFinderEnterpriseFeatureSla'),
    t(locale, 'Pricing.planFinderEnterpriseFeatureAccountManager'),
  ],
  ctaGetStarted: baseCopy.cloud.plans[0].cta.label,
};
---

<PricingPageClient
  client:load
  copy={copy}
  locale={locale}
  contactPath={contactPath}
  whatsappPath={whatsappPath}
  month={t(locale, 'Pricing.month')}
  onceSuffix={t(locale, 'Pricing.onceSuffix')}
  enterpriseContactLabel={t(locale, 'Pricing.enterpriseContactLabel')}
  planFinder={planFinder}
/>
