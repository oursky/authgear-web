---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const tFeatures = (key: string) => t(locale, `Features.${key}`);
const tCompare = (key: string) => t(locale, `Compare.${key}`);
---

<>
  <div class="featurespage__hero_v2 featurespage__hero_bg vs-page">
    <div class="features-hero-wrapper-new gap140">
      <div class="split-content features-hero-left vs-mobile">
        <h1 class="title features-hero-v2 vs-mobile">
          {t(locale, 'FirebaseAlternative.heroTitle')}
        </h1>
        <p class="features-hero-description">
          {t(locale, 'FirebaseAlternative.heroDescription')}
        </p>
        <div class="features-hero-cta-wrapper vs-mobile">
          <a
            href="https://accounts.portal.authgear.com/signup"
            target="_blank"
            class="button-primary feature-hero-btn-v2 vs-mobile w-button"
          >
            {tFeatures('startForFree')}
          </a>
          <a
            href={localizedPath(locale, '/schedule-demo')}
            target="_blank"
            class="button-secondary feature-hero-btn-v2 noscale button-secondary-with-boarder w-button"
          >
            {tFeatures('scheduleDemo')}
          </a>
        </div>
      </div>
      <img
        src="/images/compare_kv-firebase2x.webp"
        srcset="/images/compare_kv-firebase2x-p-500.webp 500w, /images/compare_kv-firebase2x.webp 600w"
        sizes="(max-width: 600px) 100vw, 600px"
        alt=""
        class="image features-hero-image-v2 _300max"
      />
    </div>
  </div>
  <div>
    <div class="container-default wider-container-default logo-section">
      <div class="container-default-inner px-0 gap-0 pb-0"></div>
      <img src="/images/compare_logo-Bupa-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-CIMIC-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-HML-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo_hkpc_gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-k11-gray2x.png" loading="lazy" alt="" class="image-86" />
      <img src="/images/compare_logo-MTR-gray2x.png" loading="lazy" alt="" class="image-86" />
    </div>
  </div>
  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0">
        <div class="top-content feature-flex">
          <h2 class="title features-page-v2">
            {t(locale, 'FirebaseAlternative.whyChooseTitle')}
          </h2>
        </div>
      </div>
      <div class="w-layout-hflex flex-block-71">
        <div class="svg-card gray-card">
          <div class="svg-card-image-container">
            <img src="/images/compare_why-enterprise.svg" loading="lazy" alt="" />
          </div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
              {t(locale, 'FirebaseAlternative.card1Title')}
            </div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
              {t(locale, 'FirebaseAlternative.card1Description')}
            </div>
          </div>
        </div>
        <div class="svg-card gray-card">
          <div class="svg-card-image-container">
            <img src="/images/compare_why-agnostic.svg" loading="lazy" alt="" />
          </div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
              {t(locale, 'FirebaseAlternative.card2Title')}
            </div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
              {t(locale, 'FirebaseAlternative.card2Description')}
            </div>
          </div>
        </div>
        <div class="svg-card gray-card">
          <div class="svg-card-image-container">
            <img src="/images/compare_why-success.svg" loading="lazy" alt="" />
          </div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
              {t(locale, 'FirebaseAlternative.card3Title')}
            </div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
              {t(locale, 'FirebaseAlternative.card3Description')}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-f9f9fb">
    <div class="container-default">
      <div class="container-default-inner px-0 gap-0">
        <div class="_2-card-grid gap-32 mb-40 _2-rows">
          <div class="svg-card">
            <div class="svg-card-image-container">
              <img src="/images/compare_features-authentication.svg" loading="lazy" alt="" />
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
                {t(locale, 'FirebaseAlternative.feature1Title')}
              </div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {t(locale, 'FirebaseAlternative.feature1Description')}
              </div>
            </div>
          </div>
          <div class="svg-card">
            <div class="svg-card-image-container">
              <img src="/images/compare_features-developer.svg" loading="lazy" alt="" />
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
                {t(locale, 'FirebaseAlternative.feature2Title')}
              </div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {t(locale, 'FirebaseAlternative.feature2Description')}
              </div>
            </div>
          </div>
          <div class="svg-card">
            <div class="svg-card-image-container">
              <img src="/images/compare_features-flow.svg" loading="lazy" width={48} alt="" />
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
                {t(locale, 'FirebaseAlternative.feature3Title')}
              </div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {t(locale, 'FirebaseAlternative.feature3Description')}
              </div>
            </div>
          </div>
          <div class="svg-card">
            <div class="svg-card-image-container">
              <img src="/images/compare_features-support.svg" loading="lazy" alt="" />
            </div>
            <div class="svg-card-content-container text-center gap-16">
              <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">
                {t(locale, 'FirebaseAlternative.feature4Title')}
              </div>
              <div class="svg-card-content-description inter text-align-left mobile-16px color-626262 line-height-26px">
                {t(locale, 'FirebaseAlternative.feature4Description')}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0">
        <div class="top-content feature-flex">
          <h2 class="title features-page-v2">
            {t(locale, 'FirebaseAlternative.compareTitle')}
          </h2>
        </div>
        <div class="div-block-25">
          <div class="w-layout-grid table-header">
            <div class="w-layout-blockcontainer w-container"></div>
            <img src="/images/compare_table-Authgear.svg" loading="lazy" alt="" />
            <div class="okta">
              {t(locale, 'FirebaseAlternative.competitorName')}
            </div>
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableNoVendorLockInTitle')}
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
              <div class="table-text">
                {t(locale, 'FirebaseAlternative.tableBackendAgnostic')}
              </div>
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
              <div class="compare-table-text-light title">
                {t(locale, 'FirebaseAlternative.tableFirebaseEcosystemNote')}
              </div>
            </div>
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableTotpPasskeyTitle')}
            </div>
            <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableWhatsappTitle')}
            </div>
            <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableAdaptiveMfaTitle')}
            </div>
            <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableSocialEnterpriseTitle')}
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
              <div class="table-text">
                {t(locale, 'FirebaseAlternative.tableSocialAuthgearExtra')}
              </div>
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-check-gray.svg" loading="lazy" alt="" />
            </div>
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableOidcSamlTitle')}
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            </div>
            <div class="compare-table-multi-info">
              <img src="/images/compare_table-check-gray.svg" loading="lazy" alt="" />
              <div class="compare-table-text-light title">
                {t(locale, 'FirebaseAlternative.tableWithIdentityPlatform')}
              </div>
            </div>
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableBrandingTitle')}
            </div>
            <div class="table-text">
              {t(locale, 'FirebaseAlternative.tableBrandingAuthgear')}
            </div>
            <div class="table-text">
              {t(locale, 'FirebaseAlternative.tableBrandingFirebase')}
            </div>
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableEmailTitle')}
            </div>
            <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
          </div>
          <div class="w-layout-grid table-header table-content">
            <div class="table-text title">
              {t(locale, 'FirebaseAlternative.tableDiscordTitle')}
            </div>
            <img src="/images/compare_table-check-blue.svg" loading="lazy" alt="" />
            <img src="/images/compare_table-false.svg" loading="lazy" alt="" />
          </div>
        </div>
      </div>
    </div>
  </div>
  <div>
    <div class="container-default wider-container-default">
      <div class="container-default-inner px-0 gap-0 pb-0"></div>
      <div class="w-layout-hflex ready-to-switch">
        <h1 class="title features-hero-v2 inverse nomargin">
          {tCompare('readyToSwitch')}
        </h1>
        <div class="split-content features-hero-left nomargin">
          <p class="features-hero-description inverse">
            {t(locale, 'FirebaseAlternative.ctaMigrateDescription')}
          </p>
          <div class="features-hero-cta-wrapper in-ready-to-switch">
            <a
              href={localizedPath(locale, '/schedule-demo')}
              target="_blank"
              class="button-primary feature-hero-btn-v2 nomargin w-button"
            >
              {tCompare('talkToUs')}
            </a>
            <a
              href="https://accounts.portal.authgear.com/signup"
              target="_blank"
              class="button-secondary feature-hero-btn-v2 noscale button-secondary-with-boarder inverse w-button"
            >
              {tFeatures('startForFree')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</>
