---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'UserManagement.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'UserManagement.heroTitle')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'UserManagement.heroDescription')}</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-user-management&utm_medium=link&utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.scheduleDemo')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'UserManagement.freePlanIncludes')} <strong>{t(locale, 'UserManagement.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-usermanagement-banner-kv2x.webp"
            srcset="/images/features-usermanagement-banner-kv2x-p-500.webp 500w, /images/features-usermanagement-banner-kv2x-p-800.webp 800w, /images/features-usermanagement-banner-kv2x-p-1080.webp 1080w, /images/features-usermanagement-banner-kv2x.webp 1244w"
            width="738"
            sizes="(max-width: 767px) 100vw, 738px"
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'UserManagement.benefitsTitle')}</h2>
      <p class="section-lede-on-light">{t(locale, 'UserManagement.benefitsDesc')}</p>
    </div>
    <div class="ds-grid-3">
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M36.7293 11.2734L11.2734 36.7292" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M24 42C14.0582 42 6 33.9418 6 24C6 14.0601 14.0582 6 24 6C33.9418 6 42 14.0601 42 24C42 30.7238 38.3142 36.586 32.8526 39.6766" stroke="#0043E0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'UserManagement.benefit1Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'UserManagement.benefit1Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M23.998 39.6656H15.5643C9.6681 39.6656 6 35.5032 6 29.6128V18.3809C6 12.4905 9.68562 8.32812 15.5643 8.32812H32.4338C38.33 8.32812 42 12.4905 42 18.3809V29.6128C42 35.5032 38.33 39.6656 32.4318 39.6656H30.564" stroke="#0043E0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M16.7734 19.7656H23.4481M16.7734 28.2374H31.2319" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'UserManagement.benefit2Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'UserManagement.benefit2Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M32.4356 6H15.5663C9.67006 6 6 10.1624 6 16.0528V31.9472C6 37.8376 9.67006 42 15.5682 42H32.4356C38.3318 42 42 37.8376 42 31.9472V16.0528C42 10.1624 38.3144 6 32.4356 6Z" stroke="#0043E0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M14.1172 19.3281L16.0437 23.8856L20.5758 21.9688" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M16.3125 23.7704C16.4293 19.1935 20.183 15.5156 24.7988 15.5156C29.4826 15.5156 33.285 19.318 33.285 24.0018C33.285 28.6956 29.4826 32.4882 24.7988 32.4882C22.3158 32.4882 20.0876 31.4276 18.5328 29.7328" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'UserManagement.benefit3Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'UserManagement.benefit3Desc')}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container ds-container--split-stack ds-container--split-stack--title-gap-m">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'UserManagement.featuresTitle')}</h2>
      <p class="section-lede-on-light">{t(locale, 'UserManagement.featuresDesc')}</p>
    </div>
    <div class="ds-split-stack__rows">
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-usermanagement-features-userdirectory.svg" loading="lazy" width="624" alt="" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'UserManagement.feature1Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'UserManagement.feature1Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-usermanagement-features-account-recovery.svg" loading="lazy" width="624" alt="" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'UserManagement.feature2Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'UserManagement.feature2Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-usermanagement-features-auditlogs.svg" loading="lazy" width="624" alt="" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'UserManagement.feature3Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'UserManagement.feature3Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-usermanagement-features-dashboard.svg" loading="lazy" width="624" alt="" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'UserManagement.feature4Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'UserManagement.feature4Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-usermanagement-features-admin-role.svg" loading="lazy" width="624" alt="" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">
            {t(locale, 'UserManagement.feature5Title')} <span class="ds-coming-soon-badge">{t(locale, 'UserManagement.feature5ComingSoon')}</span>
          </h3>
          <p class="section-lede-on-light">{t(locale, 'UserManagement.feature5Desc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'UserManagement.ctaTitle')}</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-user-management&utm_medium=link&utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        {t(locale, 'Features.startForFree')}
      </a>
      <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        {t(locale, 'Features.getDemo')}
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        {t(locale, 'UserManagement.freePlanIncludes')} <strong>{t(locale, 'UserManagement.unlimitedMAUs')}</strong>
      </p>
    </div>
  </div>
</section>
