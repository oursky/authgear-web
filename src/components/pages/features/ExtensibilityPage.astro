---
import { t } from '@/i18n';
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'Extensibility.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'Extensibility.heroTitle')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'Extensibility.heroDescription')}</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-extensibility&utm_medium=link&utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.getDemo')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'Extensibility.freePlanIncludes')} <strong>{t(locale, 'Extensibility.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-extensibility-banner-kv2x.webp"
            srcset="/images/features-extensibility-banner-kv2x-p-500.webp 500w, /images/features-extensibility-banner-kv2x-p-800.webp 800w, /images/features-extensibility-banner-kv2x-p-1080.webp 1080w, /images/features-extensibility-banner-kv2x.webp 1244w"
            width="738"
            sizes="(max-width: 767px) 100vw, 738px"
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section">
  <div class="ds-container">
    <div class="ds-feature-callout">
      <div class="ds-feature-callout__title">
        <h2 class="heading-on-dark">{t(locale, 'Extensibility.calloutTitle')}</h2>
      </div>
      <div class="ds-feature-callout__body">
        <p class="section-lede-on-dark">{t(locale, 'Extensibility.calloutDesc')}</p>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container ds-container--split-stack ds-container--split-stack--title-gap-m">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'Extensibility.hooksTitle')}</h2>
      <p class="section-lede-on-light">{t(locale, 'Extensibility.hooksDesc')}</p>
    </div>
    <div class="ds-split-stack__rows">
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-extensibility-hooks-12x.webp" loading="lazy" width="280" sizes="(max-width: 479px) 100vw, 280px" alt="" srcset="/images/features-extensibility-hooks-12x-p-500.webp 500w, /images/features-extensibility-hooks-12x-p-800.webp 800w, /images/features-extensibility-hooks-12x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Extensibility.nonBlockingTitle')}</h3>
          <ul role="list" class="ds-body-bullet-list">
            <li>{t(locale, 'Extensibility.nonBlockingItem1')}</li>
          </ul>
          <p class="section-lede-on-light"><span class="code-label">user.created</span>, <span class="code-label">user.profile.updated</span>, <span class="code-label">user.authenticated</span>, <span class="code-label">user.disabled</span>, <span class="code-label">user.reenabled</span>, {t(locale, 'Extensibility.etc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-extensibility-hooks-22x.webp" loading="lazy" width="280" sizes="(max-width: 479px) 100vw, 280px" alt="" srcset="/images/features-extensibility-hooks-22x-p-500.webp 500w, /images/features-extensibility-hooks-22x-p-800.webp 800w, /images/features-extensibility-hooks-22x-p-1080.webp 1080w, /images/features-extensibility-hooks-22x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Extensibility.blockingTitle')}</h3>
          <ul role="list" class="ds-body-bullet-list">
            <li>{t(locale, 'Extensibility.blockingItem1')}</li>
          </ul>
          <p class="section-lede-on-light"><span class="code-label">user.pre_created</span>, <span class="code-label">user.profile.pre_updated</span>, <span class="code-label">user.pre_schedule_deletion</span>, <span class="code-label">oidc.jwt.pre_create</span>, {t(locale, 'Extensibility.etc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-extensibility-hooks-32x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/4baaeb37e3dc49d716925e6d451e0434_features-extensibility-hooks-32x-p-500.webp 500w, /images/4baaeb37e3dc49d716925e6d451e0434_features-extensibility-hooks-32x-p-800.webp 800w, /images/features-extensibility-hooks-32x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Extensibility.buildTitle')}</h3>
          <ul role="list" class="ds-body-bullet-list">
            <li><strong>{t(locale, 'Extensibility.buildItem1Title')}</strong><br />{t(locale, 'Extensibility.buildItem1Desc')}</li>
            <li><strong>{t(locale, 'Extensibility.buildItem2Title')}</strong><br />{t(locale, 'Extensibility.buildItem2Desc')}</li>
            <li><strong>{t(locale, 'Extensibility.buildItem3Title')}</strong><br />{t(locale, 'Extensibility.buildItem3Desc')}</li>
            <li><strong>{t(locale, 'Extensibility.buildItem4Title')}</strong><br />{t(locale, 'Extensibility.buildItem4Desc')}</li>
          </ul>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-extensibility-adminapi2x.webp" loading="lazy" width="624" sizes="(max-width: 767px) 100vw, 624px" alt="" srcset="/images/features-extensibility-adminapi2x-p-500.webp 500w, /images/features-extensibility-adminapi2x-p-800.webp 800w, /images/features-extensibility-adminapi2x-p-1080.webp 1080w, /images/features-extensibility-adminapi2x.webp 1248w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Extensibility.adminApiTitle')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Extensibility.adminApiDesc')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section passwordless-section-dark-bg">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'Extensibility.devExpTitle')}</h2>
    </div>
    <div class="ds-grid-3">
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M23.7344 32.3334C28.6532 34.2994 34.4812 33.297 38.4638 29.3146C42.4598 25.3184 43.4622 19.4632 41.4574 14.5579L34.658 21.3574C34.0442 21.9692 33.166 22.2374 32.3152 22.0702L29.1058 21.435C28.0744 21.231 27.2662 20.4248 27.0602 19.3933L26.4192 16.1723C26.2482 15.3195 26.5162 14.4394 27.1302 13.8256L33.9276 7.02814C31.1964 5.92248 28.1806 5.73562 25.3544 6.47218" stroke="#0043E0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M19.1716 10.0234C15.1892 14.0059 14.1867 19.834 16.1644 24.7664L8.02844 32.9024C5.88374 35.049 5.9323 38.5768 8.22078 40.6556C10.3713 42.6098 13.7555 42.3146 15.8108 40.2612L19.7729 36.2982" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Extensibility.devExp1Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Extensibility.devExp1Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M13.6368 29.1445L9.98688 30.9007C8.13598 31.7631 8.03784 34.3751 9.81878 35.3755L20.3124 41.2711C22.8324 42.6871 25.9012 42.6871 28.4212 41.2711" stroke="#0043E0" stroke-width="3" stroke-linecap="round"></path>
            <path d="M35.3473 29.0039L38.9705 30.8463C40.7639 31.7491 40.8215 34.3045 39.0707 35.2883L33.7461 38.2797" stroke="#0043E0" stroke-width="3" stroke-linecap="round"></path>
            <path d="M35.2074 20.1788L38.4874 21.9532L39.2884 22.4032C40.9946 23.3618 40.9946 25.8332 39.2884 26.7918L28.4224 32.8966C25.9024 34.3124 22.8336 34.3124 20.3136 32.8966L9.44763 26.7918C7.74141 25.8332 7.74141 23.3618 9.44763 22.4032L10.2485 21.9532L13.4408 20.125" stroke="#31B7FF" stroke-width="3"></path>
            <path d="M28.4224 7.39782C25.9024 5.98198 22.8336 5.98198 20.3136 7.3978L9.44763 13.5026C7.74141 14.4612 7.74141 16.9326 9.44763 17.8912L20.3136 23.996C22.8336 25.4118 25.9024 25.4118 28.4224 23.996L39.2884 17.8912C40.9946 16.9326 40.9946 14.4612 39.2884 13.5026L33.8554 10.4502" stroke="#0043E0" stroke-width="3" stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Extensibility.devExp2Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Extensibility.devExp2Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M12.689 13.1016H12.5781M17.6603 13.1016H17.5494M22.6336 13.1016H22.5226" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M17.6094 23.8125V41.9009" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M17.6758 29.4766H36.7952" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M36.1526 18.9844H6" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M6 31.9472C6 37.8376 9.67006 42 15.5663 42H32.4338C38.3318 42 42 37.8376 42 31.9472V16.0528C42 10.1624 38.3318 6 32.4356 6H15.5663C9.68756 6 6 10.1624 6 16.0528V24" stroke="#0043E0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Extensibility.devExp3Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Extensibility.devExp3Desc')}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'Extensibility.ctaTitle')}</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-extensibility&utm_medium=link&utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        {t(locale, 'Features.startForFree')}
      </a>
      <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        {t(locale, 'Features.getDemo')}
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        {t(locale, 'Extensibility.freePlanIncludes')} <strong>{t(locale, 'Extensibility.unlimitedMAUs')}</strong>
      </p>
    </div>
  </div>
</section>
