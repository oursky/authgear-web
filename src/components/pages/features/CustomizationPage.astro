---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import LoginCustomizationPlayground from '@/components/islands/customization/LoginCustomizationPlayground';
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'Customization.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'Customization.heroTitle')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'Customization.heroDescription')}</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-customization&utm_medium=link&utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.scheduleDemo')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'Customization.freePlanIncludes')} <strong>{t(locale, 'Customization.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-customization-banner-kv2x.webp"
            srcset="/images/features-customization-banner-kv2x-p-500.webp 500w, /images/features-customization-banner-kv2x-p-800.webp 800w, /images/features-customization-banner-kv2x-p-1080.webp 1080w, /images/features-customization-banner-kv2x.webp 1244w"
            width="622"
            sizes="(max-width: 767px) 100vw, 622px"
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section mm-empower-section-bg">
  <div class="ds-container ds-container--split-stack  ds-container--split-stack--title-gap-m">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'Customization.darkSectionTitle')}</h2>
    </div>
    <div class="ds-grid-2">
      <div class="svg-card svg-card-deep">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M23.3092 6C20.6068 6 18.4159 8.19086 18.4159 10.8934L18.8938 14.8365C19.1862 17.2448 17.3083 19.3644 14.8831 19.3644H11.5378C9.6562 19.3644 8.12878 20.8862 8.12502 22.7678V22.781C8.1194 24.6758 9.65244 26.2106 11.5453 26.2106H35.0976C36.9868 26.2106 38.5178 24.6794 38.5178 22.7904C38.5178 20.8994 36.983 19.3663 35.092 19.3701L31.7448 19.3757C29.3252 19.3794 27.4474 17.2673 27.7322 14.8665L28.2046 10.8934C28.2046 8.19086 26.0118 6 23.3092 6Z" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M18.8075 40.6702C14.1484 40.6682 9.33874 40.6646 9.32188 40.659C8.2911 40.4152 7.85256 39.3546 8.40354 38.4512C8.54224 38.2244 10.5288 35.4358 10.3564 31.1496V26.2236" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M23.3203 10.9971V10.9771" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M34.8746 41.5346L35.0692 41.0082C35.8028 39.0228 37.3658 37.4574 39.3484 36.7226L39.8742 36.5278L39.3484 36.333C37.3658 35.5984 35.8028 34.033 35.0692 32.0476L34.8746 31.521L34.6802 32.0476C33.9466 34.033 32.3834 35.5984 30.401 36.333L29.875 36.5278L30.401 36.7226C32.3834 37.4574 33.9466 39.0228 34.6802 41.0082L34.8746 41.5346Z" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M22.9214 36.5278C23.311 35.246 24.3126 34.2426 25.5926 33.8526C24.3126 33.4624 23.311 32.4592 22.9214 31.1772C22.5318 32.4592 21.53 33.4624 20.25 33.8526C21.53 34.2426 22.5318 35.246 22.9214 36.5278Z" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M26.0234 42H26.0434" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Customization.card1Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Customization.card1Desc')}</div>
        </div>
        <a
          href="https://docs.authgear.com/customization/built-in-ui/branding"
          target="_blank"
          rel="noreferrer"
          class="ds-btn ds-btn-tertiary customization-empower-cta--flush-inline"
        >
          {t(locale, 'Customization.card1Cta')}
          <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
      <div class="svg-card svg-card-deep">
        <div class="icon-w48">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none">
            <path d="M14.2139 17.5703L6.5 23.9978L14.2139 30.4274" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M34.7891 17.5703L42.5029 23.9978L34.7891 30.4274" stroke="#31B7FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M24.5025 24L19.3594 38.1434" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M29.6419 9.85938L27.0703 16.9311" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Customization.card2Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Customization.card2Desc')}</div>
        </div>
        <a
          href="https://docs.authgear.com/customization/custom-ui/authentication-flow-api"
          target="_blank"
          rel="noreferrer"
          class="ds-btn ds-btn-tertiary customization-empower-cta--flush-inline"
        >
          {t(locale, 'Customization.card2Cta')}
          <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
    <LoginCustomizationPlayground client:visible locale={locale} />
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container ds-container--split-stack ds-container--split-stack--title-gap-m">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'Customization.featuresTitle')}</h2>
      <p class="section-lede-on-light">{t(locale, 'Customization.featuresDesc')}</p>
    </div>
    <div class="ds-split-stack__rows">
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-01-selfserve2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-01-selfserve2x-p-500.webp 500w, /images/features-customization-features-01-selfserve2x-p-800.webp 800w, /images/features-customization-features-01-selfserve2x-p-1080.webp 1080w, /images/features-customization-features-01-selfserve2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature1Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature1Desc')}</p>
          <a href={localizedPath(locale, "/features/self-serve-settings-page")} class="ds-btn ds-btn-subtle">
            {t(locale, 'Customization.feature1Cta')}
            <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-03-security2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-03-security2x-p-500.webp 500w, /images/features-customization-features-03-security2x-p-800.webp 800w, /images/features-customization-features-03-security2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature2Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature2Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-04-sso2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-04-sso2x-p-500.webp 500w, /images/features-customization-features-04-sso2x-p-800.webp 800w, /images/features-customization-features-04-sso2x-p-1080.webp 1080w, /images/features-customization-features-04-sso2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature3Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature3Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-05-sociallogin2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-05-sociallogin2x-p-500.webp 500w, /images/features-customization-features-05-sociallogin2x-p-800.webp 800w, /images/features-customization-features-05-sociallogin2x-p-1080.webp 1080w, /images/features-customization-features-05-sociallogin2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature4Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature4Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-06-sdk2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-06-sdk2x-p-500.webp 500w, /images/features-customization-features-06-sdk2x-p-800.webp 800w, /images/features-customization-features-06-sdk2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature5Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature5Desc')}</p>
        </div>
      </div>
      <div class="ds-split ds-split-row ds-split-row--reverse ds-split-row--surface-light">
        <div class="ds-split-row__media">
          <img src="/images/features-customization-features-07-hooks2x.webp" loading="lazy" width="560" sizes="(max-width: 767px) 100vw, 560px" alt="" srcset="/images/features-customization-features-07-hooks2x-p-500.webp 500w, /images/features-customization-features-07-hooks2x-p-800.webp 800w, /images/features-customization-features-07-hooks2x-p-1080.webp 1080w, /images/features-customization-features-07-hooks2x.webp 1120w" class="ds-split-row__img" />
        </div>
        <div class="ds-split-row__body">
          <h3 class="heading-on-light">{t(locale, 'Customization.feature6Title')}</h3>
          <p class="section-lede-on-light">{t(locale, 'Customization.feature6Desc')}</p>
          <a href={localizedPath(locale, "/features/extensibility")} class="ds-btn ds-btn-subtle">
            {t(locale, 'Customization.feature6Cta')}
            <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'Customization.ctaTitle')}</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-customization&utm_medium=link&utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        {t(locale, 'Features.startForFree')}
      </a>
      <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        {t(locale, 'Features.getDemo')}
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        {t(locale, 'Customization.freePlanIncludes')} <strong>{t(locale, 'Customization.unlimitedMAUs')}</strong>
      </p>
    </div>
  </div>
</section>
