---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';

interface Props { locale: string }
const { locale } = Astro.props;

const USE_CASE_SLUGS = ['k11', 'global-qsr', 'hongkong-land'] as const;
const slugOf = (id: string) => id.replace(/^(en|zh-Hant)\//, '').replace(/\/index(\.(md|mdx))?$/, '');
const allStories = await getCollection('customer-stories', ({ id }) => id.startsWith('en/'));
const useCaseStories = USE_CASE_SLUGS
  .map((s) => allStories.find((e) => slugOf(e.id) === s))
  .filter((e): e is NonNullable<typeof e> => !!e);
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'Authentication.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">
              {t(locale, 'Authentication.heroTitleLine1')}
              <br />
              {t(locale, 'Authentication.heroTitleLine2')}
            </h1>
            <p class="ds-hero-banner__description">
              {t(locale, 'Authentication.heroDescLine1')} {t(locale, 'Authentication.heroDescLine2')}
            </p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-authentication&amp;utm_medium=link&amp;utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg class="ds-btn__icon-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.getDemo')}
                <svg class="ds-btn__icon-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'Authentication.freePlanIncludes')} <strong>{t(locale, 'Authentication.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-authentication-hero-banner2x.webp"
            srcset="/images/features-authentication-hero-banner2x-p-500.webp 500w, /images/features-authentication-hero-banner2x-p-800.webp 800w, /images/features-authentication-hero-banner2x-p-1080.webp 1080w, /images/features-authentication-hero-banner2x.webp 1476w"
            sizes="(max-width: 767px) 100vw, 738px"
            width={738}
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'Authentication.implementTitle')}</h2>
    </div>
    <div class="ds-grid-4">
      <div class="svg-card">
        <div class="svg-card-image-container">
          <img src="/images/features-authentication-fast-implement-1.svg" loading="lazy" alt="" />
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Authentication.card1')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="svg-card-image-container">
          <img src="/images/features-authentication-fast-implement-2.svg" loading="lazy" alt="" />
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Authentication.card2')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="svg-card-image-container">
          <img src="/images/features-authentication-fast-implement-3.svg" loading="lazy" alt="" />
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Authentication.card3')}</div>
        </div>
      </div>
      <div class="svg-card">
        <div class="svg-card-image-container">
          <img src="/images/features-attackprotection-values-04.svg" loading="lazy" alt="" />
        </div>
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Authentication.card4')}</div>
        </div>
      </div>
    </div>
  </div>
</section>

