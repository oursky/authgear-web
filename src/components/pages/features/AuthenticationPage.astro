<section class="ds-section authentication-dev-experience-section">
  <div class="ds-container ds-container--max-callout">
    <div class="authentication-dev-experience-section__surface">
      <div class="authentication-dev-experience-section__layout">
        <div class="title-content authentication-dev-experience-section__title-col">
          <h2 class="heading-on-dark">
            {t(locale, 'Authentication.devExpTitleLine1')}
            <br />
            {t(locale, 'Authentication.devExpTitleLine2')}
          </h2>
        </div>
        <div class="authentication-dev-experience-section__cards-col">
          <div class="ds-grid-2">
            <div class="svg-card">
              <div class="ds-svg-card-content">
                <div class="ds-svg-card-title">{t(locale, 'Authentication.sdksLabel')}</div>
                <div class="ds-svg-card-description">{t(locale, 'Authentication.sdksDesc')}</div>
              </div>
            </div>
            <div class="svg-card">
              <div class="ds-svg-card-content">
                <div class="ds-svg-card-title">{t(locale, 'Authentication.adminApiLabel')}</div>
                <div class="ds-svg-card-description">{t(locale, 'Authentication.adminApiDesc')}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-white">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">Use Cases</h2>
    </div>
    <div class="ds-grid-3 authentication-use-cases">
      {useCaseStories.map((entry) => {
        const slug = slugOf(entry.id);
        const href = localizedPath(locale, `/customer-stories/${slug}`);
        return (
          <a href={href} class="authentication-use-case-card">
            <Image
              src={entry.data.coverImage}
              alt={entry.data.title}
              width={600}
              class="authentication-use-case-card__img"
              loading="lazy"
            />
            <div class="authentication-use-case-card__body">
              <p class="authentication-use-case-card__title">{entry.data.title}</p>
              <span class="authentication-use-case-card__cta">
                See Case Studies
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'Authentication.ctaTitle')}</h2>
      <p class="section-lede-on-dark">{t(locale, 'Authentication.ctaDesc')}</p>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-authentication&amp;utm_medium=link&amp;utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        {t(locale, 'Features.startForFree')}
      </a>
      <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        {t(locale, 'Features.getDemo')}
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
