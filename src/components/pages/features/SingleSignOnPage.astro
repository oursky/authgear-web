---
import ContactForm from '@/components/islands/ContactForm';
import { localizedPath } from '@/lib/i18n';
interface Props { locale: string }
const { locale } = Astro.props;
---
<div class="featurespage__hero_v2 featurespage__hero_bg">
  <div class="features-hero-wrapper-new">
    <div class="split-content features-hero-left">
      <div class="featurespage__hero-titletag">Single Sign On</div>
      <h1 class="title features-hero-v2">Elevate Your App with Effortless SSO Login</h1>
      <p class="features-hero-description">Simplify user experience and boost security with Authgear's OIDC-based SSO solution. Experience the benefits of enhanced user engagement and reduced friction.</p>
      <div class="features-hero-cta-wrapper">
        <a href="https://portal.authgear.com/?utm_source=feature-sso&amp;utm_medium=link&amp;utm_campaign=start-for-free" target="_blank" class="button-primary feature-hero-btn-v2 w-button">Start for Free</a>
        <a href={localizedPath(locale, "/schedule-demo")} target="_blank" class="button-secondary feature-hero-btn-v2 noscale w-button">Schedule Demo  <span class="text-span-23">{">"}</span></a>
      </div>
    </div><img src="/images/features-sso-hero-kv.svg" alt="" class="image features-hero-image-v2" />
  </div>
</div>
<div class="bg-f9f9fb">
  <div class="container-default">
    <div class="container-default-inner px-0 gap-0">
      <div class="top-content feature-flex mb-60">
        <h2 class="title features-page-v2">What is <span class="text-highlight-gradient">SSO?</span></h2>
        <p class="paragraph-large text-center features-page-v2">Single Sign-On (SSO) is an authentication method that allows users to access multiple applications and websites with a single set of credentials. This means users only need to log in once to access all their connected accounts.</p>
      </div>
      <div class="_3-card-grid">
        <div id="w-node-b67fc327-8839-9646-504a-e7e2057fe51f-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-sso-whatis-convenience.svg" loading="lazy" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">Convenience</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">Users save time and frustration by not having to remember multiple passwords.</div>
          </div>
        </div>
        <div id="w-node-b67fc327-8839-9646-504a-e7e2057fe527-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-sso-whatis-security.svg" loading="lazy" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">Enhanced Security</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">By reducing the number of times users enter their credentials, the risk of unauthorized access is minimized.</div>
          </div>
        </div>
        <div id="w-node-b67fc327-8839-9646-504a-e7e2057fe52f-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-passkeys-authentication-icon-ux.svg" loading="lazy" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px">Improved User Experience</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">A seamless login process increases user satisfaction and engagement.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="bg-f9f9fb">
  <div class="container-default">
    <div class="container-default-inner px-0 gap-0">
      <div class="top-content feature-flex mb-60">
        <h2 class="title features-page-v2">How OIDC-Based <span class="text-highlight-gradient">SSO Works?</span></h2>
        <p class="paragraph-large text-center features-page-v2">OpenID Connect (OIDC) enables Single Sign-On (SSO) by establishing a trust relationship between an Authorization Server (AS) and a Relying Party (RP). This allows users to authenticate once and access multiple applications without re-entering credentials.</p>
      </div>
      <div class="_3-card-grid">
        <div id="w-node-_88d6aedb-51f1-486b-74f7-88af8cb3216f-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">1</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">Boost User Satisfaction</div>
            <div class="svg-card-content-description inter size-14 color-626262">Simplify the login process, reduce password-related frustrations, and increase user engagement.</div>
          </div>
        </div>
        <div id="w-node-_66d8a841-5f69-fdff-aea0-9e69be7fe28f-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">2</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">Redirection to Authorization Server</div>
            <div class="svg-card-content-description inter size-14 color-626262">The RP redirects the user to the Authorization Server (AS) with an authorization request.</div>
          </div>
        </div>
        <div id="w-node-b30df303-aab0-c5cf-a06d-2ef68ed32051-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">3</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">User authentication</div>
            <div class="svg-card-content-description inter size-14 color-626262">The AS prompts the user for credentials and authenticates them.</div>
          </div>
        </div>
        <div id="w-node-_7263040c-de30-810c-5054-720162a31e96-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">4</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">Authorization and token issuance</div>
            <div class="svg-card-content-description inter size-14 color-626262">Upon successful authentication, the AS issues an ID token and potentially an access token to the user's browser.</div>
          </div>
        </div>
        <div id="w-node-a6bbb84f-e170-1c84-5bcf-b60ebf45d0b0-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">5</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">Redirection with token</div>
            <div class="svg-card-content-description inter size-14 color-626262">The user is redirected back to the RP with the ID token.</div>
          </div>
        </div>
        <div id="w-node-_7c834473-3729-9e3b-d31b-976a84e328f0-e7a18d43" class="svg-card bg-eff2fc gap-16 py-24 px-32">
          <div class="svg-card-image-container center">
            <div class="card-number">6</div>
          </div>
          <div class="svg-card-content-container text-center gap-6">
            <div class="svg-card-content-title inter color-2e2e2e size-18">Token validation and access</div>
            <div class="svg-card-content-description inter size-14 color-626262">The RP validates the ID token to verify the user's identity and grants access to the requested resource.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="bg-f9f9fb">
  <div class="container-default">
    <div class="container-default-inner px-0 gap-0">
      <div class="top-content feature-flex mb-60">
        <h2 class="title features-page-v2">3 Benefits of <span class="text-highlight-gradient">Implementing SSO for Your Business </span></h2>
        <p class="paragraph-large text-center features-page-v2">SSO offers a multitude of advantages for businesses of all sizes. By streamlining access, enhancing security, and improving user satisfaction, SSO can significantly impact your bottom line.</p>
      </div>
      <div class="_3-card-grid">
        <div id="w-node-c5d7a487-ba4d-1906-a5b6-92cdc38cf44f-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-passkeys-security-icon-employee.svg" loading="lazy" width="48" height="auto" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px size-22">User Initiates Login</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">Simplify the login process, reduce password-related frustrations, and increase user engagement.</div>
          </div>
        </div>
        <div id="w-node-c5d7a487-ba4d-1906-a5b6-92cdc38cf457-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-sso-benefits-security.svg" loading="lazy" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px size-22">Strengthen Security</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">Protect your sensitive data by reducing the risk of unauthorized access and password breaches.</div>
          </div>
        </div>
        <div id="w-node-c5d7a487-ba4d-1906-a5b6-92cdc38cf45f-e7a18d43" class="svg-card p-0 pr-24 bg-transparent">
          <div class="svg-card-image-container"><img src="/images/features-sso-benefits-efficiency.svg" loading="lazy" alt="" /></div>
          <div class="svg-card-content-container text-center gap-16">
            <div class="svg-card-content-title left inter color-2e2e2e mobile-20px size-22">Improve Efficiency</div>
            <div class="svg-card-content-description inter text-align-left mobile-16px color-626262">Streamline operations, save time, and enhance productivity through faster and easier access to applications.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="bg-f9f9fb">
  <div class="container-default">
    <div class="container-default-inner px-0 gap-0 pb-0">
      <div class="top-content feature-flex mb-60">
        <h2 class="title features-page-v2">Simplify SSO Implementation<span class="text-highlight-gradient"> with Authgear</span></h2>
        <p class="paragraph-large text-center features-page-v2">Authgear provides a robust and flexible platform for implementing SSO in your web and mobile applications. Leveraging the power of OpenID Connect (OIDC), Authgear simplifies the SSO process, allowing you to focus on building exceptional user experiences.</p>
      </div>
      <div class="features-flex-container gap-40 reverse-order">
        <div class="solution-image-block"><img src="/images/features-sso-oidc-based.svg" loading="lazy" alt="" /></div>
        <div class="features-text-block p-0">
          <h3 class="features-h3-dark">OIDC-Based SSO</h3>
          <div class="gradient-divider"></div>
          <div class="color-626262 line-height-24px">Authgear's SSO solution is built on the foundation of OpenID Connect (OIDC), an industry-standard protocol for authentication and authorization. By adhering to OIDC standards, Authgear ensures seamless integration with a wide range of applications and services.</div>
        </div>
      </div>
      <div class="features-flex-container gap-40">
        <div class="solution-image-block"><img src="/images/features-sso-why-authgear.svg" loading="lazy" alt="" /></div>
        <div class="features-text-block p-0">
          <h3 class="features-h3-dark">Why Authgear?</h3>
          <div class="gradient-divider"></div>
          <ul role="list" class="_2-block-flex-content-list">
            <li class="_2-block-flex-content-list-item line-height-24px with-subcontent">Rapid Integration<span class="list-subcontent">Authgear offers pre-built SDKs and APIs, accelerating development time and reducing implementation complexity.</span></li>
            <li class="_2-block-flex-content-list-item line-height-24px with-subcontent">Enhanced Security<span class="list-subcontent">Benefit from robust security features, including advanced encryption, protection against common vulnerabilities, and compliance with industry standards.</span></li>
            <li class="_2-block-flex-content-list-item line-height-24px with-subcontent">Scalability<span class="list-subcontent">Handle increasing user loads with ease, as Authgear is designed to scale effortlessly.</span></li>
            <li class="_2-block-flex-content-list-item line-height-24px with-subcontent">Customization<span class="list-subcontent">Tailor the login experience to match your brand identity and user preferences.</span></li>
            <li class="_2-block-flex-content-list-item line-height-24px with-subcontent">Comprehensive Features<span class="list-subcontent">Beyond SSO, Authgear provides additional features like user management, social login, and multi-factor authentication.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="bg-f3f6ff">
  <div class="container-default">
    <div class="container-default-inner px-0 gap-0">
      <div class="top-content feature-flex mb-60">
        <h2 class="title features-page-v2">Dive Deeper into <span class="text-highlight-gradient">SSO</span></h2>
        <p class="paragraph-large text-center features-page-v2">Expand your SSO knowledge with our informative blog posts:</p>
      </div>
      <div class="secondary-block">
        <div class="_2-card-grid">
          <a href={localizedPath(locale, "/post/customer-sso")} target="_blank" class="secondary-block-card-link bg-white w-inline-block">
            <div class="secondary-block-card-image-container"><img src="/images/features-mfa-deepdive-article.svg" loading="lazy" alt="" class="secondary-block-card-image" /></div>
            <div class="blog-post-link-with-desc">
              <div class="secondary-block-card-content">What is Customer SSO and Why Should You Implement it?</div>
              <div class="blog-post-link-desc">Learn more about the advantages of Single Sign-On for your customers and how your business can benefit from a unified login experience.</div>
            </div>
          </a>
          <a href={localizedPath(locale, "/post/oidc-vs-saml-decoding-the-sso-showdown-and-why-it-matters-for-your-business")} target="_blank" class="secondary-block-card-link bg-white w-inline-block">
            <div class="secondary-block-card-image-container"><img src="/images/features-mfa-deepdive-article.svg" loading="lazy" alt="" class="secondary-block-card-image" /></div>
            <div class="blog-post-link-with-desc">
              <div class="secondary-block-card-content">OIDC vs. SAML: Decoding the SSO Showdown (And Why It Matters for Your Business)</div>
              <div class="blog-post-link-desc">Choosing the right Single Sign-On (SSO) solution for your business can feel like traversing a labyrinth of acronyms.</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="footer-form-section form__bg-dark">
  <div class="container-default">
    <div class="container-default-inner px-0">
      <div class="_2-block-flex footer-form">
        <div class="_2-block-flex-content footer-form">
          <div class="_2-block-flex-content-text-wrap footer-form">
            <h2 class="form-heading color-white footer-form">Ready to Transform Your Login Experience?</h2>
            <div class="color-cee9ff">Experience the Authgear difference. Sign up for a free trial and discover how easy it is to implement SSO for your business.</div>
            <div class="footerform__divider-sm"></div>
            <div class="color-white footer-get-started-text">Get started today! Free trials available.</div>
          </div>
        </div>
        <div class="_2-block-flex-image footer-form">
          <ContactForm client:visible locale={locale} />
        </div>
      </div>
    </div>
  </div>
</div>
