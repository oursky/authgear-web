<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'AttackProtection.valuesSectionTitle')}</h2>
    </div>
    <div class="ds-grid-2">
      <div class="svg-card">
        <img src="/images/features-attackprotection-values-01.svg" loading="lazy" alt="" />
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-description">{t(locale, 'AttackProtection.value1')}</div>
        </div>
      </div>
      <div class="svg-card">
        <img src="/images/b2b-saas-why-customized.svg" loading="lazy" alt="" />
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-description">{t(locale, 'AttackProtection.value2')}</div>
        </div>
