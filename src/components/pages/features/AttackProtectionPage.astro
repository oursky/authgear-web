<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'AttackProtection.ctaTitle')}</h2>
      <p class="section-lede-on-dark">{t(locale, 'AttackProtection.ctaDescription')}</p>
    </div>
    <div class="ds-footer-cta__actions">
      <a
