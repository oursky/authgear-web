<section class="ds-section attack-protection-built-for">
  <div class="ds-container">
    <div class="attack-protection-built-for__surface">
      <div class="attack-protection-built-for__content">
        <h2 class="heading-on-dark">{t(locale, 'AttackProtection.builtForTitle')}</h2>
        <p class="section-lede-on-dark">{t(locale, 'AttackProtection.builtForDescription')}</p>
      </div>
    </div>
  </div>
