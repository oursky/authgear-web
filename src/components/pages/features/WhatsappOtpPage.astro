---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
interface Props { locale: string }
const { locale } = Astro.props;

const WHY_CARDS = [
  { img: '/images/features-otp-whyotp-01.svg', titleKey: 'WhatsAppOtp.why1Title', descKey: 'WhatsAppOtp.why1Desc' },
  { img: '/images/features-otp-whyotp-02.svg', titleKey: 'WhatsAppOtp.why2Title', descKey: 'WhatsAppOtp.why2Desc' },
  { img: '/images/features-otp-whyotp-03.svg', titleKey: 'WhatsAppOtp.why3Title', descKey: 'WhatsAppOtp.why3Desc' },
  { img: '/images/features-otp-whyotp-04.svg', titleKey: 'WhatsAppOtp.why4Title', descKey: 'WhatsAppOtp.why4Desc' },
] as const;

const HOW_STEPS = [
  { img: '/images/features-otp-howitworks-phonenumber.svg', stepKey: 'WhatsAppOtp.step1' },
  { img: '/images/features-otp-howitworks-otp.svg', stepKey: 'WhatsAppOtp.step2' },
  { img: '/images/features-otp-howitworks-submitcode.svg', stepKey: 'WhatsAppOtp.step3' },
] as const;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'WhatsAppOtp.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'WhatsAppOtp.heroTitle')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'WhatsAppOtp.heroDescription')}</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-whatsapp-otp&amp;utm_medium=link&amp;utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.getDemo')}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'WhatsAppOtp.freePlanIncludes')} <strong>{t(locale, 'WhatsAppOtp.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-whatsappotp-hero-banner2x.png"
            srcset="/images/features-whatsappotp-hero-banner2x-p-500.png 500w, /images/features-whatsappotp-hero-banner2x-p-800.png 800w, /images/features-whatsappotp-hero-banner2x-p-1080.png 1080w, /images/features-whatsappotp-hero-banner2x.png 1459w"
            sizes="(max-width: 767px) 100vw, 738px"
            width={738}
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'WhatsAppOtp.whyTitle')}</h2>
      <p class="section-lede-on-light">{t(locale, 'WhatsAppOtp.whyDescription')}</p>
    </div>
    <div class="ds-grid-2">
      {WHY_CARDS.map((card) => (
        <div class="svg-card">
          <div class="svg-card-image-container">
            <img src={card.img} loading="lazy" alt="" />
          </div>
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{t(locale, card.titleKey)}</div>
            <div class="ds-svg-card-description">{t(locale, card.descKey)}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">{t(locale, 'WhatsAppOtp.howItWorksTitle')}</h2>
    </div>
    <div class="wa-how-grid">
      {HOW_STEPS.map((s) => (
        <div class="wa-how-step">
          <div class="wa-how-step__figure">
            <img src={s.img} loading="lazy" alt="" class="wa-how-step__img" />
          </div>
          <div class="wa-how-step__title">{t(locale, s.stepKey)}</div>
        </div>
      ))}
    </div>
    <div class="wa-how-checks">
      <ul role="list" class="wa-how-checks__list">
        <li>
          <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" class="wa-how-checks__icon" />
          <span>
            {t(locale, 'WhatsAppOtp.checkPoint1Pre')}
            <strong>{t(locale, 'WhatsAppOtp.checkPoint1Bold')}</strong>
            {t(locale, 'WhatsAppOtp.checkPoint1Post')}
          </span>
        </li>
        <li>
          <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" class="wa-how-checks__icon" />
          <span>{t(locale, 'WhatsAppOtp.checkPoint2')}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .wa-how-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    width: 100%;
    margin-top: 2.5rem;
  }
  @media (min-width: 768px) {
    .wa-how-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .wa-how-step {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem;
    background-color: #fff;
    border: 0.0625rem solid #e0e0e0;
    border-radius: 1.25rem;
    box-shadow: 0 0.125rem 0.75rem rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
  }

  .wa-how-step__figure {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
  }

  .wa-how-step__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 20rem;
    object-fit: contain;
  }

  .wa-how-step__title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 600;
    color: var(--color-text-light-primary);
  }

  .wa-how-checks {
    margin-top: 1.5rem;
    padding: 1.75rem 2rem;
    background-color: #fff;
    border: 0.0625rem solid #e0e0e0;
    border-radius: 1.25rem;
    box-shadow: 0 0.125rem 0.75rem rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
  }

  .wa-how-checks__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wa-how-checks__list > li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5rem;
    color: var(--color-text-light-primary);
  }

  .wa-how-checks__icon {
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.25rem;
  }
</style>

<section class="ds-section ds-footer-cta-section">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-dark">{t(locale, 'WhatsAppOtp.ctaTitle')}</h2>
    </div>
    <div class="ds-footer-cta__actions">
      <a
        href="https://portal.authgear.com/?utm_source=feature-whatsapp-otp&amp;utm_medium=link&amp;utm_campaign=start-for-free"
        target="_blank"
        rel="noreferrer"
        class="ds-btn ds-btn-secondary"
      >
        {t(locale, 'Features.startForFree')}
      </a>
      <a href={localizedPath(locale, "/schedule-demo")} target="_blank" rel="noreferrer" class="ds-btn ds-btn-outline-light">
        {t(locale, 'WhatsAppOtp.getADemo')}
      </a>
    </div>
    <div class="ds-footer-cta__footnote">
      <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
      <p class="ds-footer-cta__footnote-copy">
        {t(locale, 'WhatsAppOtp.freePlanIncludes')} <strong>{t(locale, 'WhatsAppOtp.unlimitedMAUs')}</strong>
      </p>
    </div>
  </div>
</section>
