---
import { t } from '@/i18n';
import ContactForm from '@/components/islands/ContactForm';
import PasswordlessChallengeFlipCard from '@/components/islands/PasswordlessChallengeFlipCard';
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="ds-hero-banner--gradient">
  <div class="ds-container ds-container--gradient-hero-shell">
    <div class="ds-hero-banner--gradient__inner">
      <div class="ds-container ds-container--hero">
        <div class="ds-hero-banner__row">
          <div class="ds-hero-banner__body">
            <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'Passwordless.heroSmallTitle')}</p>
            <h1 class="ds-hero-banner__title">{t(locale, 'Passwordless.heroTitle')}</h1>
            <p class="ds-hero-banner__description">{t(locale, 'Passwordless.heroDescription')}</p>
            <div class="ds-hero-banner__ctas">
              <a
                href="https://portal.authgear.com/?utm_source=feature-passwordless&amp;utm_medium=link&amp;utm_campaign=start-for-free"
                target="_blank"
                rel="noreferrer"
                class="ds-btn ds-btn-secondary"
              >
                {t(locale, 'Features.startForFree')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
              <a href="/schedule-demo" target="_blank" rel="noreferrer" class="ds-btn ds-btn-tertiary">
                {t(locale, 'Features.getDemo')}
                <svg xmlns="http://www.w3.org/2000/svg" class="ds-btn__icon-arrow" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
              </a>
            </div>
            <div class="ds-hero-banner__footnote">
              <img src="/images/features-hero-banner-check-purple.svg" loading="lazy" alt="" />
              <p class="ds-hero-banner__footnote-copy">
                {t(locale, 'Passwordless.freePlanIncludes')} <strong>{t(locale, 'Passwordless.unlimitedMAUs')}</strong>
              </p>
            </div>
          </div>
          <img
            class="ds-hero-banner__media"
            src="/images/features-passwordless-hero-kv.svg"
            width="738"
            alt=""
          />
        </div>
      </div>
    </div>
  </div>
</section>
<section class="ds-section ds-bg-light-blue">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">
        {t(locale, 'Passwordless.ditchTitle')}
        <br />
        {t(locale, 'Passwordless.ditchTitleLine2')}
        {t(locale, 'Passwordless.ditchTitleHighlight')}
      </h2>
      <p class="section-lede-on-light">{t(locale, 'Passwordless.ditchDescription')}</p>
    </div>
    <div class="ds-grid-3">
      <div class="svg-card">
        <img src="/images/features-passwordless-ditch-icon-security.svg" loading="lazy" alt="" />
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Passwordless.card1Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Passwordless.card1Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <img src="/images/features-passwordless-ditch-icon-ux.svg" loading="lazy" alt="" />
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Passwordless.card2Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Passwordless.card2Desc')}</div>
        </div>
      </div>
      <div class="svg-card">
        <img src="/images/features-passwordless-ditch-icon-convenience.svg" loading="lazy" alt="" />
        <div class="ds-svg-card-content">
          <div class="ds-svg-card-title">{t(locale, 'Passwordless.card3Title')}</div>
          <div class="ds-svg-card-description">{t(locale, 'Passwordless.card3Desc')}</div>
        </div>
      </div>
    </div>
  </div>
</section>
<section
  class="ds-section passwordless-section-dark-bg"
  aria-label={t(locale, 'Passwordless.sectionConvenienceToBiometricAriaLabel')}
>
  <div class="ds-container ds-container--split-stack">
    <div class="ds-split ds-split-row ds-split-row--reverse">
      <div class="ds-split-row__media">
        <img
          src="/images/features-passwordless-social-login.svg"
          loading="lazy"
          width="624"
          alt=""
          class="ds-split-row__img"
        />
      </div>
      <div class="ds-split-row__body">
        <h2 class="heading-on-dark">
          {t(locale, 'Passwordless.socialLoginTitle')}
          <br />
          {t(locale, 'Passwordless.socialLoginTitleHighlight')}
        </h2>
        <p class="section-lede-on-dark">{t(locale, 'Passwordless.socialLoginDesc')}</p>
        <a href="/features/social-login" class="ds-btn ds-btn-outline-light">
          {t(locale, 'Passwordless.exploreSocialLogin')}
        </a>
      </div>
    </div>
    <div class="ds-split ds-split-row">
      <div class="ds-split-row__media">
        <img
          src="/images/features-passwordless-passkey.svg"
          loading="lazy"
          width="624"
          alt=""
          class="ds-split-row__img"
        />
      </div>
      <div class="ds-split-row__body">
        <h2 class="heading-on-dark">
          {t(locale, 'Passwordless.passkeysTitle')}
          <br />
          {t(locale, 'Passwordless.passkeysTitleHighlight')}
        </h2>
        <p class="section-lede-on-dark">{t(locale, 'Passwordless.passkeysDesc')}</p>
        <a href="/features/passkeys" class="ds-btn ds-btn-outline-light">
          {t(locale, 'Passwordless.discoverPasskeys')}
        </a>
      </div>
    </div>
    <div class="ds-split ds-split-row ds-split-row--reverse">
      <div class="ds-split-row__media">
        <img
          src="/images/features-passwordless-biometric.svg"
          loading="lazy"
          width="624"
          alt=""
          class="ds-split-row__img"
        />
      </div>
      <div class="ds-split-row__body">
        <h2 class="heading-on-dark">
          {t(locale, 'Passwordless.biometricTitle')}
          <br />
          {t(locale, 'Passwordless.biometricTitleHighlight')}
        </h2>
        <p class="section-lede-on-dark">{t(locale, 'Passwordless.biometricDesc')}</p>
        <a href="/features/biometric-authentication" class="ds-btn ds-btn-outline-light">
          {t(locale, 'Passwordless.biometricLogin')}
        </a>
      </div>
    </div>
  </div>
</section>
<section class="ds-section">
  <div class="ds-container">
    <div class="ds-feature-callout ds-feature-callout--cta-accent">
      <div class="ds-feature-callout__title">
        <h2 class="heading-on-dark">{t(locale, 'Passwordless.magicLinkTitle')}</h2>
        <p class="section-lede-on-dark">{t(locale, 'Passwordless.magicLinkDesc')}</p>
      </div>
      <div class="ds-feature-callout__body">
        <div class="ds-feature-callout__media">
          <img
            src="/images/seamless-logins_login-box.png"
            srcset="/images/seamless-logins_login-box-p-500.png 500w, /images/seamless-logins_login-box-p-800.png 800w, /images/seamless-logins_login-box-p-1080.png 1080w, /images/seamless-logins_login-box.png 1368w"
            sizes="(max-width: 767px) 100vw, 684px"
            width="684"
            loading="lazy"
            alt=""
            class="ds-feature-callout__media-img"
          />
        </div>
      </div>
    </div>
  </div>
</section>
<section class="ds-section">
  <div class="ds-container ds-container--split-stack">
    <div class="ds-split ds-split-row ds-split-row--reverse">
      <div class="ds-split-row__media">
        <img
          src="/images/features-passwordless-otp-whatsapp.svg"
          loading="lazy"
          width="624"
          alt=""
          class="ds-split-row__img"
        />
      </div>
      <div class="ds-split-row__body">
        <h2 class="heading-on-light">
          {t(locale, 'Passwordless.challengesOtpTitle')}
          <br />
          {t(locale, 'Passwordless.challengesOtpSubtitle')}
        </h2>
        <p class="section-lede-on-light">{t(locale, 'Passwordless.challengesOtpDesc')}</p>
      </div>
    </div>
  </div>
</section>
<section class="ds-section ds-bg-white">
  <div class="ds-container">
    <div class="title-content">
      <h2 class="heading-on-light">
        {t(locale, 'Passwordless.challengesTitle')}
        <br />
        {t(locale, 'Passwordless.challengesTitleLine2')}
        {t(locale, 'Passwordless.challengesTitleHighlight')}
        {t(locale, 'Passwordless.challengesTitleEnd')}
      </h2>
      <p class="section-lede-on-light">{t(locale, 'Passwordless.challengesDescription')}</p>
    </div>
    <div class="ds-grid-3">
      <PasswordlessChallengeFlipCard
        client:visible
        webflowNodeId="w-node-_00cfbc02-babb-5e85-058e-e310d1fa3fab-e43d3961"
        frontIconSrc="/images/features-passwordless-challenges-icon-integrations.svg"
        frontTitle={t(locale, 'Passwordless.challenge1Front')}
        frontDesc={t(locale, 'Passwordless.challenge1FrontDesc')}
        backText={t(locale, 'Passwordless.challenge1Back')}
      />
      <PasswordlessChallengeFlipCard
        client:visible
        webflowNodeId="w-node-_00cfbc02-babb-5e85-058e-e310d1fa3fbd-e43d3961"
        frontIconSrc="/images/features-passwordless-challenges-icon-training.svg"
        frontTitle={t(locale, 'Passwordless.challenge2Front')}
        frontDesc={t(locale, 'Passwordless.challenge2FrontDesc')}
        backText={t(locale, 'Passwordless.challenge2Back')}
      />
      <PasswordlessChallengeFlipCard
        client:visible
        webflowNodeId="w-node-_00cfbc02-babb-5e85-058e-e310d1fa3fcf-e43d3961"
        frontIconSrc="/images/features-passwordless-challenges-icon-balance.svg"
        frontTitle={t(locale, 'Passwordless.challenge3Front')}
        frontDesc={t(locale, 'Passwordless.challenge3FrontDesc')}
        backText={t(locale, 'Passwordless.challenge3Back')}
      />
    </div>
  </div>
</section>
<div class="footer-form-section form__bg-dark">
  <div class="container-default">
    <div class="container-default-inner px-0">
      <div class="_2-block-flex footer-form">
        <div class="_2-block-flex-content footer-form">
          <div class="_2-block-flex-content-text-wrap footer-form">
            <h2 class="form-heading color-white footer-form">{t(locale, 'Passwordless.ctaTitle')}</h2>
            <div class="color-cee9ff">{t(locale, 'Passwordless.ctaDesc')}</div>
            <div class="footerform__divider-sm"></div>
            <div class="color-white footer-get-started-text">{t(locale, 'Passwordless.ctaGetStarted')}</div>
          </div>
        </div>
        <div class="_2-block-flex-image footer-form">
          <ContactForm client:load locale={locale} />
        </div>
      </div>
    </div>
  </div>
</div>
