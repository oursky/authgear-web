---
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import { getPartners } from '@/lib/partners';

interface Props { locale: string }
const { locale } = Astro.props;

const partners = await getPartners();
---

<div class="page-wrapper">
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero partners-index__hero">
          <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'Partners.eyebrow')}</p>
          <h1 class="ds-hero-banner__title">{t(locale, 'Partners.heroTitle')}</h1>
          <p class="ds-hero-banner__description">{t(locale, 'Partners.heroDescription')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      {partners.length === 0 ? (
        <p class="partners-empty">{t(locale, 'Partners.noPartnersYet')}</p>
      ) : (
        <ul role="list" class="partners-grid">
          {partners.map((partner) => (
            <li class="partners-grid__item">
              <div class="partner-card">
                {partner.logo_url && (
                  <div class="partner-card__logo">
                    <img src={partner.logo_url} alt={partner.name} loading="lazy" />
                  </div>
                )}
                <h3 class="partner-card__name">{partner.name}</h3>
                {partner.country && <p class="partner-card__country">{partner.country}</p>}
                {partner.description && <p class="partner-card__description">{partner.description}</p>}
                {partner.website && (
                  <a
                    href={partner.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="partner-card__link plausible-event-name--partner-website-click"
                  >
                    {t(locale, 'Partners.visitWebsite')}
                    <svg class="partner-card__link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}

      <div class="partners-cta">
        <h2 class="partners-cta__title">{t(locale, 'Partners.ctaTitle')}</h2>
        <p class="partners-cta__body">{t(locale, 'Partners.ctaBody')}</p>
        <a
          href={localizedPath(locale, '/become-a-partner')}
          class="ds-btn ds-btn-subtle plausible-event-name--become-a-partner-click"
        >
          {t(locale, 'Partners.ctaButton')}
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  .partners-empty {
    margin: 0 auto;
    max-width: 640px;
    text-align: center;
    font-size: 1.125rem;
    color: #626262;
  }
  .partners-grid {
    /* .ds-container is a centering flex column and a global rule sets
       justify-items: center on grids — stretch both ways so cards fill
       their column from the left. */
    width: 100%;
    justify-items: stretch;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (max-width: 767px) {
    .partners-grid { grid-template-columns: 1fr; }
  }
  .partners-grid__item { display: flex; }
  .partner-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    padding: 3rem 2.5rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .partner-card:hover {
    border-color: #c7d2fe;
    box-shadow: 0 4px 10px rgba(16, 24, 40, 0.06), 0 10px 24px rgba(16, 24, 40, 0.08);
    transform: translateY(-2px);
  }
  .partner-card__logo {
    height: 72px;
    display: flex;
    align-items: center;
  }
  .partner-card__logo img {
    height: 100%;
    width: auto;
    max-width: 260px;
    object-fit: contain;
    object-position: left center;
  }
  .partner-card__name {
    margin: 0;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #0f172a;
  }
  .partner-card__country {
    margin: -0.5rem 0 0;
    font-size: 1rem;
    color: #626262;
  }
  .partner-card__description {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #626262;
  }
  .partner-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-brand-primary, #0043e0);
    text-decoration: none;
  }
  .partner-card__link:hover .partner-card__link-arrow {
    transform: translateX(4px);
  }
  .partner-card__link-arrow {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }
  .partners-cta {
    margin-top: 4rem;
    padding: 2.5rem 2rem;
    border: 1px solid #e5e7eb;
    border-radius: 1rem;
    background: #f8fafc;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .partners-cta__title {
    margin: 0;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #0f172a;
  }
  .partners-cta__body {
    margin: 0;
    font-size: 1rem;
    color: #626262;
  }
</style>
