---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { t } from '@/i18n';
import { localizedPath } from '@/lib/i18n';
import ContactForm from '@/components/islands/ContactForm';
import formxLogo from '@/assets/logos/formx.png';

interface Props { locale: string }
const { locale } = Astro.props;

// Logo wall: customer-story logos link to the company website. FormX has no
// customer story; its logo lives in src/assets/logos/.
const logoWallConfig: { slug?: string; name: string; website: string; logo?: ImageMetadata }[] = [
  { slug: 'hongkong-mtr', name: 'HongKong MTR', website: 'https://www.mtr.com.hk' },
  { slug: 'hongkong-land', name: 'Hongkong Land', website: 'https://www.hkland.com' },
  { slug: 'k11', name: 'K11', website: 'https://hk.k11.com/' },
  { slug: 'cornerstone-technologies', name: 'Cornerstone Technologies', website: 'https://www.cstl.com.hk/' },
  { slug: 'outback-steakhouse', name: 'Outback Steakhouse', website: 'https://www.outback.com.hk/' },
  { slug: 'bupa', name: 'Bupa', website: 'https://www.bupa.com' },
  { name: 'FormX.ai', website: 'https://www.formx.ai', logo: formxLogo },
];

const allStories = await getCollection('customer-stories', ({ id }) => id.startsWith('en/'));
const slugOf = (e: (typeof allStories)[number]) =>
  e.id.replace(/^en\//, '').replace(/\/index(\.(md|mdx))?$/, '');

const logoWall = logoWallConfig.flatMap((item) => {
  if (item.logo) return [{ name: item.name, website: item.website, logo: item.logo }];
  const story = allStories.find((e) => slugOf(e) === item.slug);
  if (!story?.data.companyLogo) return [];
  return [{ name: item.name, website: item.website, logo: story.data.companyLogo }];
});
---

<div class="page-wrapper">
  <!-- SECTION: Hero -->
  <section class="ds-hero-banner--dark about-hero">
    <div class="ds-container ds-container--hero">
      <div class="ds-hero-banner__row about-hero__row">
        <div class="ds-hero-banner__body about-hero__body">
          <h1 class="ds-hero-banner__title">{t(locale, 'About.heroTitle')}</h1>
          <p class="ds-hero-banner__description">{t(locale, 'About.heroSubhead')}</p>
          <div class="ds-hero-banner__ctas about-hero__ctas">
            <a href={localizedPath(locale, '/schedule-demo')} class="ds-btn ds-btn-secondary">
              {t(locale, 'About.heroCta1')}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
            <a href={localizedPath(locale, '/pricing')} class="ds-btn ds-btn-tertiary">
              {t(locale, 'About.heroCta2')}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="ds-btn__icon-arrow" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION: Why we built Authgear -->
  <section class="ds-section ds-bg-light-blue">
    <div class="ds-container">
      <div class="title-content">
        <p class="ds-section-eyebrow">{t(locale, 'About.whyEyebrow')}</p>
        <h2 class="heading-on-light">{t(locale, 'About.whyTitle')}</h2>
      </div>
      <div class="about-why__prose">
        <p class="section-lede-on-light">{t(locale, 'About.whyP1')}</p>
        <p class="section-lede-on-light">{t(locale, 'About.whyP2')}</p>
        <p class="section-lede-on-light">{t(locale, 'About.whyP3')}</p>
      </div>
    </div>
  </section>

  <!-- SECTION: Product principles -->
  <section class="ds-section">
    <div class="ds-container">
      <div class="title-content">
        <h2 class="heading-on-light">{t(locale, 'About.principlesTitle')}</h2>
      </div>
      <div class="ds-grid-3">
        <div class="svg-card">
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{t(locale, 'About.principles1Title')}</div>
            <div class="ds-svg-card-description">{t(locale, 'About.principles1Desc')}</div>
          </div>
        </div>
        <div class="svg-card">
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{t(locale, 'About.principles2Title')}</div>
            <div class="ds-svg-card-description">{t(locale, 'About.principles2Desc')}</div>
          </div>
        </div>
        <div class="svg-card">
          <div class="ds-svg-card-content">
            <div class="ds-svg-card-title">{t(locale, 'About.principles3Title')}</div>
            <div class="ds-svg-card-description">{t(locale, 'About.principles3Desc')}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION: Company snapshot -->
  <section class="ds-section ds-bg-light-blue">
    <div class="ds-container">
      <div class="title-content">
        <h2 class="heading-on-light">{t(locale, 'About.snapshotTitle')}</h2>
      </div>
      <dl class="about-snapshot__facts">
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotBuiltByLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotBuiltByValue')}</dd>
        </div>
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotFoundedLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotFoundedValue')}</dd>
        </div>
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotTeamLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotTeamValue')}</dd>
        </div>
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotComplianceLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotComplianceValue')}</dd>
        </div>
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotPledgeLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotPledgeValue')}</dd>
        </div>
        <div class="about-snapshot__fact">
          <dt class="about-snapshot__fact-label">{t(locale, 'About.snapshotCloudLabel')}</dt>
          <dd class="about-snapshot__fact-value">{t(locale, 'About.snapshotCloudValue')}</dd>
        </div>
      </dl>
      <div class="about-snapshot__badges">
        <img
          src="/images/Authgear_footer_certificated_blue2x.png"
          alt="ISO 27001 and SoC 2 Type II certified"
          class="about-snapshot__badge"
          loading="lazy"
        />
        <a
          href="https://fidoalliance.org/passkeypledge/"
          target="_blank"
          rel="noopener noreferrer"
          class="about-snapshot__badge-link"
          aria-label="Passkey Pledge Partner"
        >
          <img
            src="/images/PasskeyPledge_color.png"
            alt="Passkey Pledge Partner"
            class="about-snapshot__badge"
            loading="lazy"
          />
        </a>
        <img
          src="/images/1111.png"
          alt="Microsoft Azure"
          class="about-snapshot__cloud-logo"
          loading="lazy"
        />
        <img
          src="/images/gcp.png"
          alt="Google Cloud"
          class="about-snapshot__cloud-logo"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- SECTION: Customer proof -->
  <section class="ds-section">
    <div class="ds-container">
      <div class="title-content">
        <h2 class="heading-on-light">{t(locale, 'About.customersTitle')}</h2>
      </div>
      <div class="about-logo-wall" role="list">
        {logoWall.map((item) => (
          <a
            href={item.website}
            class="about-logo-wall__item"
            role="listitem"
            aria-label={item.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Image
              src={item.logo}
              alt={item.name}
              width={160}
              class="about-logo-wall__img"
              loading="lazy"
            />
          </a>
        ))}
      </div>
      <div class="about-logo-wall__cta">
        <a href={localizedPath(locale, '/customer-stories')} class="ds-btn ds-btn-secondary">
          {t(locale, 'About.customersCta')}
          <svg class="ds-btn__icon-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION: Footer Form -->
  <div class="footer-form-section form__bg-dark">
    <div class="container-default">
      <div class="container-default-inner px-0">
        <div class="_2-block-flex footer-form">
          <div class="_2-block-flex-content footer-form">
            <div class="_2-block-flex-content-text-wrap footer-form">
              <h2 class="form-heading color-white footer-form">{t(locale, 'About.footerTitle')}</h2>
              <div class="footerform__divider-sm"></div>
              <div class="color-white footer-get-started-text">{t(locale, 'About.footerBody')}</div>
            </div>
          </div>
          <div class="_2-block-flex-image footer-form">
            <ContactForm client:visible locale={locale} />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Center the About hero (no media image, single-column). Overrides the
     default left-aligned layout that ds-hero-banner* applies in row mode.
     The ds stylesheet sets `h1.ds-hero-banner__title { text-align: left }`
     and the same for the description paragraph, so we re-target those
     elements with higher specificity below. */
  .about-hero__row {
    justify-content: center !important;
  }
  .about-hero__body {
    align-items: center;
    max-width: 820px;
    margin: 0 auto;
  }
  .about-hero h1.ds-hero-banner__title,
  .about-hero p.ds-hero-banner__description {
    text-align: center;
  }
  .about-hero__ctas {
    justify-content: center;
  }

  .about-why__prose {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: center;
  }
  .about-snapshot__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 2.5rem;
    max-width: 960px;
    margin: 2.5rem auto 3rem;
    padding: 0;
  }
  .about-snapshot__fact {
    text-align: center;
    padding: 0 0.5rem;
  }
  .about-snapshot__fact-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7a94;
    margin: 0 0 0.5rem;
  }
  .about-snapshot__fact-value {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    font-weight: 500;
    color: #1a2a4e;
  }
  @media (max-width: 767px) {
    .about-snapshot__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1rem;
    }
  }
  @media (max-width: 419px) {
    .about-snapshot__facts {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
  .about-snapshot__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
  }
  .about-snapshot__badge {
    height: 72px;
    width: auto;
  }
  .about-snapshot__cloud-logo {
    height: 40px;
    width: auto;
    opacity: 0.85;
  }
  .about-snapshot__badge-link {
    display: inline-flex;
    align-items: center;
  }
  .about-logo-wall {
    display: flex;
    flex-wrap: wrap;
    column-gap: 4rem;
    row-gap: 2rem;
    align-items: center;
    justify-content: center;
    margin: 2.5rem auto 2rem;
    max-width: 880px;
  }
  .about-logo-wall__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 0.25rem;
  }
  .about-logo-wall__img {
    width: auto;
    max-width: 160px;
    max-height: 40px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .about-logo-wall__item:hover .about-logo-wall__img {
    filter: grayscale(0);
    opacity: 1;
  }
  .about-logo-wall__cta {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }
  @media (max-width: 767px) {
    .about-logo-wall {
      column-gap: 2rem;
      row-gap: 1.25rem;
    }
    .about-logo-wall__img {
      max-width: 130px;
      max-height: 34px;
    }
  }
</style>
