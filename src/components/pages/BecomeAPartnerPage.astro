---
import { t } from '@/i18n';

interface Props { locale: string }
const { locale } = Astro.props;

const REGISTER_URL = 'https://partners.skymakers.digital/register';
const CONTACT_EMAIL = 'hello@authgear.com';

const benefits = [
  {
    title: t(locale, 'BecomeAPartner.benefit1Title'),
    body: t(locale, 'BecomeAPartner.benefit1Body'),
    icon: 'revenue',
  },
  {
    title: t(locale, 'BecomeAPartner.benefit2Title'),
    body: t(locale, 'BecomeAPartner.benefit2Body'),
    icon: 'support',
  },
  {
    title: t(locale, 'BecomeAPartner.benefit3Title'),
    body: t(locale, 'BecomeAPartner.benefit3Body'),
    icon: 'marketing',
  },
];
---

<div class="page-wrapper">
  <section class="ds-hero-banner--gradient">
    <div class="ds-container ds-container--gradient-hero-shell">
      <div class="ds-hero-banner--gradient__inner">
        <div class="ds-container ds-container--hero become-a-partner__hero">
          <p class="ds-section-eyebrow ds-section-eyebrow--on-dark">{t(locale, 'BecomeAPartner.eyebrow')}</p>
          <h1 class="ds-hero-banner__title">{t(locale, 'BecomeAPartner.heroTitle')}</h1>
          <p class="ds-hero-banner__description">{t(locale, 'BecomeAPartner.heroDescription')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ds-section ds-bg-white">
    <div class="ds-container">
      <h2 class="partner-benefits__title">{t(locale, 'BecomeAPartner.benefitsTitle')}</h2>
      <ul role="list" class="partner-benefits">
        {benefits.map((benefit) => (
          <li class="partner-benefit">
            <div class="partner-benefit__icon" aria-hidden="true">
              {benefit.icon === 'revenue' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.5 20.5H20.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M5.5 16.5V13.5M10 16.5V10.5M14.5 16.5V12M19 16.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M5.5 9L10 6.5L14.5 8L19 4M19 4H15.5M19 4V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {benefit.icon === 'support' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3L2.5 7.5L12 12L21.5 7.5L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M6 9.75V15C6 15 8.25 17 12 17C15.75 17 18 15 18 15V9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M21.5 7.5V13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
              {benefit.icon === 'marketing' && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.5 10V14C3.5 14.5523 3.94772 15 4.5 15H7L12.5 19V5L7 9H4.5C3.94772 9 3.5 9.44772 3.5 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M16 9.5C16.6 10.1 17 11 17 12C17 13 16.6 13.9 16 14.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M18.5 7C19.7 8.2 20.5 10 20.5 12C20.5 14 19.7 15.8 18.5 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="partner-benefit__title">{benefit.title}</h3>
            <p class="partner-benefit__body">{benefit.body}</p>
          </li>
        ))}
      </ul>

      <div class="partner-register">
        <a
          href={REGISTER_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="ds-btn ds-btn-primary plausible-event-name--partner-register-click"
        >
          {t(locale, 'BecomeAPartner.registerButton')}
        </a>
        <p class="partner-register__contact">
          {t(locale, 'BecomeAPartner.contactPrefix')}
          <a href={`mailto:${CONTACT_EMAIL}`} class="plausible-event-name--partner-contact-click">{CONTACT_EMAIL}</a>
          {t(locale, 'BecomeAPartner.contactSuffix')}
        </p>
      </div>
    </div>
  </section>
</div>

<style>
  .become-a-partner__hero {
    text-align: center;
  }
  .become-a-partner__hero .ds-hero-banner__title,
  .become-a-partner__hero .ds-hero-banner__description {
    margin-inline: auto;
    text-align: center;
  }
  .partner-benefits__title {
    margin: 0 0 2.5rem;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 2rem;
    font-weight: 600;
    color: #0f172a;
    text-align: center;
  }
  .partner-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 991px) {
    .partner-benefits { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
  .partner-benefit {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 1.75rem;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 0.875rem;
  }
  .partner-benefit__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: #eef2ff;
    color: var(--color-brand-primary, #0043e0);
  }
  .partner-benefit__title {
    margin: 0;
    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #0f172a;
  }
  .partner-benefit__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #626262;
  }
  .partner-register {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }
  .partner-register__contact {
    margin: 0;
    font-size: 1rem;
    color: #626262;
  }
  .partner-register__contact a {
    color: var(--color-brand-primary, #0043e0);
    font-weight: 600;
  }
</style>
