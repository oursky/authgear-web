---
import { t } from '@/i18n';
import type { Locale } from '@/lib/i18n';
import { localizedPath } from '@/lib/i18n';
import { ALPHABET, glossaryTerms } from '@/lib/glossary-data';

interface Props { locale: string }
const { locale } = Astro.props;
const sections = glossaryTerms[(locale as Locale)] ?? glossaryTerms.en;
const activeLetters = new Set(sections.map((s) => s.letter));
---
<div class="page-wrapper">

  <section class="glossary">
    <div class="login-default-inner-section gallery-banner">
      <h1 class="glossary-h1">{t(locale, 'Glossary.title')}</h1>
      <p class="glossary-subtitle subtitle-paddings">{t(locale, 'Glossary.description')}</p>
      <div class="div-block-30">
        <div class="w-layout-hflex anchor-container">
          {ALPHABET.map((l) => (
            activeLetters.has(l) ? (
              <a href={`#Glossary-${l}`} class="anchor-link w-inline-block"><div class="glossary-anchor">{l}</div></a>
            ) : (
              <a href="#" class="anchor-link inactive-glossary w-inline-block"><div class="glossary-anchor inactive">{l}</div></a>
            )
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="div-block-30 sticky">
    <div class="w-layout-hflex anchor-container">
      {ALPHABET.map((l) => (
        activeLetters.has(l) ? (
          <a href={`#Glossary-${l}`} class="anchor-link w-inline-block"><div class="glossary-anchor">{l}</div></a>
        ) : (
          <a href="#" class="anchor-link inactive-glossary w-inline-block"><div class="glossary-anchor inactive">{l}</div></a>
        )
      ))}
    </div>
  </div>

  <section>
    <div class="login-default-inner-section glossary-content-inner-section">
      {sections.map((section) => (
        <div id={`Glossary-${section.letter}`} class="w-layout-vflex glossary-container">
          <div class="first-letter">{section.letter}</div>
          {section.entries.map((entry) => (
            <div class="w-layout-hflex glossary-block">
              {entry.link ? (
                <a href={entry.link.startsWith('/') ? localizedPath(locale, entry.link) : entry.link} class="glossary-link w-inline-block">
                  <div class="text-block-85 with-link">{entry.term}</div>
                  <img src="/images/glossary-link.svg" loading="lazy" alt="" />
                </a>
              ) : (
                <div class="text-block-85">{entry.term}</div>
              )}
              <p class="paragraph-19" set:html={entry.body}></p>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="login-default-inner-section"></div>
  </section>

</div>
