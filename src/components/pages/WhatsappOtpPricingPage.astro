</section>

<script is:inline define:vars={{ DATA, I18N: { popular: copy.sectionPopular, all: copy.sectionAll, noMatch: copy.noMatch } }}>
  (function () {
    var input = document.getElementById('ag-pl-input');
    var dropdown = document.getElementById('ag-pl-dropdown');
    var result = document.getElementById('ag-pl-result');
    var chips = document.querySelectorAll('.wa-chip');
    if (!input || !dropdown || !result) return;

    var elCountry = document.getElementById('ag-pl-country');
    var elPrice = document.getElementById('ag-pl-price');
    var elSavings = document.getElementById('ag-pl-savings');
    var elSavingsVal = document.getElementById('ag-pl-savings-val');
    var elCompare = document.getElementById('ag-pl-compare');
    var elBarWa = document.getElementById('ag-pl-bar-wa');
    var elBarSms = document.getElementById('ag-pl-bar-sms');
    var elWaVal = document.getElementById('ag-pl-wa-val');
    var elSmsVal = document.getElementById('ag-pl-sms-val');

    function buildOption(item) {
      var div = document.createElement('button');
      div.type = 'button';
      div.className = 'wa-opt';
      div.setAttribute('role', 'option');

      var iso = document.createElement('span');
      iso.className = 'wa-opt__iso';
      iso.textContent = item.iso;
      div.appendChild(iso);

      var name = document.createElement('span');
      name.className = 'wa-opt__name';
      name.textContent = item.country;
      div.appendChild(name);

      var price = document.createElement('span');
      price.className = 'wa-opt__price';
      price.textContent = '$' + item.wa.toFixed(4);
      div.appendChild(price);

      if (item.popular) {
        var tag = document.createElement('span');
        tag.className = 'wa-opt__tag';
        tag.textContent = '★';
        tag.title = 'Popular';
        div.appendChild(tag);
      }
      div.addEventListener('mousedown', function (e) {
        e.preventDefault();
        select(item);
      });
      return div;
    }

    function renderDropdown(query) {
      dropdown.innerHTML = '';
      var q = (query || '').toLowerCase();
      var matches = DATA.filter(function (d) {
        return !q || d.country.toLowerCase().indexOf(q) !== -1 || d.iso.toLowerCase().indexOf(q) !== -1;
      });

      if (!q) {
        var pop = matches.filter(function (d) { return d.popular; });
        var rest = matches.filter(function (d) { return !d.popular; });
        if (pop.length) {
          dropdown.appendChild(section(I18N.popular));
          pop.forEach(function (d) { dropdown.appendChild(buildOption(d)); });
        }
        if (rest.length) {
          dropdown.appendChild(section(I18N.all));
          rest.forEach(function (d) { dropdown.appendChild(buildOption(d)); });
        }
      } else {
        matches.forEach(function (d) { dropdown.appendChild(buildOption(d)); });
      }

      if (!dropdown.children.length) {
        var empty = document.createElement('div');
        empty.className = 'wa-opt wa-opt--empty';
        empty.textContent = I18N.noMatch.replace('{q}', query);
        dropdown.appendChild(empty);
      }
      dropdown.classList.add('open');
    }

    function section(text) {
      var h = document.createElement('div');
      h.className = 'wa-opt__section';
      h.textContent = text;
      return h;
    }

    function select(item) {
      input.value = item.country;
      dropdown.classList.remove('open');
      result.setAttribute('data-state', 'filled');

      elCountry.textContent = item.country + ' · ' + item.iso;
      elPrice.textContent = item.wa.toFixed(4);

      var savings = item.sms > 0 ? Math.round((1 - item.wa / item.sms) * 100) : 0;
      if (savings > 0) {
        elSavings.hidden = false;
        elSavingsVal.textContent = '−' + savings + '%';
      } else {
        elSavings.hidden = true;
      }

      elCompare.hidden = false;
      elWaVal.textContent = '$' + item.wa.toFixed(4);
      elSmsVal.textContent = '$' + item.sms.toFixed(4);
      var max = Math.max(item.wa, item.sms);
      var waW = max > 0 ? (item.wa / max) * 100 : 0;
      var smsW = max > 0 ? (item.sms / max) * 100 : 0;
      // animate from 0
      elBarWa.style.width = '0%';
      elBarSms.style.width = '0%';
      requestAnimationFrame(function () {
        elBarWa.style.width = waW + '%';
        elBarSms.style.width = smsW + '%';
      });
    }

    input.addEventListener('focus', function () { renderDropdown(input.value); });
    input.addEventListener('input', function () { renderDropdown(input.value); });
    input.addEventListener('blur', function () {
      setTimeout(function () { dropdown.classList.remove('open'); }, 150);
    });

    // "/" shortcut to focus
    document.addEventListener('keydown', function (e) {
      if (e.key === '/' && document.activeElement !== input) {
        var tag = document.activeElement && document.activeElement.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        e.preventDefault();
        input.focus();
      } else if (e.key === 'Escape' && document.activeElement === input) {
        input.blur();
      }
    });

    chips.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = {
          iso: btn.getAttribute('data-iso'),
          country: btn.getAttribute('data-country'),
          wa: parseFloat(btn.getAttribute('data-wa')),
          sms: parseFloat(btn.getAttribute('data-sms')),
          popular: true,
        };
        select(item);
      });
    });
  })();
</script>

