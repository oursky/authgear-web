            <span class="wa-kv-value">{copy.kvTemplateVal}</span>
          </div>
          <div class="wa-terminal__row">
            <span class="wa-kv-label">{copy.kvBenchmark}</span>
            <span class="wa-kv-value">{copy.kvBenchmarkVal}</span>
          </div>
          <div class="wa-terminal__row">
            <span class="wa-kv-label">{copy.kvUpdated}</span>
            <span class="wa-kv-value wa-kv-value--mono">2026-03</span>
          </div>

          <div class="wa-terminal__divider" aria-hidden="true"></div>

          <label class="wa-kv-label" for="ag-pl-input">{copy.lookupLabel}</label>
          <div class="wa-search" id="wa-search">
            <svg class="wa-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="m21 21-4.3-4.3" />
