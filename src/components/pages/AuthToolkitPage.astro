              <div class="toolkit-button-label">{T('passkeyOpen')}</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card more-toolkit">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/more.svg" loading="lazy" alt="" /></div>
              <div class="color-white">{T('moreName')}</div>
            </div>
            <p class="toolkit-description">{T('moreDesc')}</p>
            <div class="w-layout-vflex comming-soon">
              <div>{T('moreLabel')}</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="toolkit-learn-more-section">
    <div class="login-default-inner-section glossary-content-inner-section">
      <div class="login-default-inner-section gallery-banner toolkit">
        <h2 class="toolkit-h2">{T('learnMoreTitle')}</h2>
        <p class="glossary-subtitle subtitle-paddings toolkit">{T('learnMoreSubtitle')}</p>
      </div>
      <div class="w-layout-vflex toolkit-learn-more-container">
        <a href={localizedPath(locale, "/post/jwe-vs-jwt")} target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">{T('article1')}</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">{T('readArticle')}</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, "/post/what-is-jwks")} target="_blank" class="link-block-6 w-inline-block">
