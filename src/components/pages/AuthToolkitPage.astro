---
import { t } from '@/i18n';

interface Props { locale: string }
const { locale } = Astro.props;
---

<div class="page-wrapper">

  <div class="div-block-31">
    <section class="glossary toolkit">
      <div class="login-default-inner-section gallery-banner">
        <div class="w-layout-hflex flex-block-81">
          <div class="w-layout-hflex tookkit-tag free-tag">
            <div class="tag-text">Free</div>
          </div>
          <div class="w-layout-hflex tookkit-tag">
            <div class="tag-text">Open-source</div>
          </div>
        </div>
        <h1 class="glossary-h1 toolkit">Auth Developer<br /><span class="text-span-44">Mini-Toolkit</span></h1>
        <p class="glossary-subtitle subtitle-paddings toolkit">In-browser JWT/JWE, JWK/JWKS, HMAC, SAML, and TOTP tools for developers. Perfect for authentication development and testing.</p>
        <div>
          <a href="https://www.producthunt.com/products/developer-auth-mini-toolkit-by-authgear?embed=true&utm_source=badge-featured&utm_medium=badge&utm_source=badge-developer&#0045;auth&#0045;mini&#0045;toolkit&#0045;by&#0045;authgear" target="_blank"><img src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1014586&theme=light&t=1757429766572" alt="Developer&#0032;Auth&#0032;Mini&#0045;Toolkit&#0032;by&#0032;Authgear - 5&#0032;minitools&#0032;for&#0032;auth&#0032;builders | Product Hunt" style="width: 250px; height: 54px;" width="250" height="54" /></a>
        </div>
        <a href="https://github.com/authgear/authgear-server/" target="_blank" class="w-inline-block"><img alt="GitHub Repo stars" src="https://img.shields.io/github/stars/authgear/authgear-server?style=social&label=GitHub%20Stars" /></a>
      </div>
    </section>
    <section>
      <div class="login-default-inner-section glossary-content-inner-section">
        <div class="w-layout-hflex flex-block-82">
          <div class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/jwt-jwe-debugger.svg" loading="lazy" alt="" /></div>
              <div class="color-white">JWT &amp; JWE Debugger</div>
            </div>
            <p class="toolkit-description">Decode &amp; verify JWTs; encrypt/decrypt JWEs.</p>
            <a href="/tools/jwt-jwe-debugger" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open JWT &amp; JWE Debugger</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/jwk-enerator.svg" loading="lazy" alt="" /></div>
              <div class="color-white">JWK Generator</div>
            </div>
            <p class="toolkit-description">Convert PEM &lt;&gt; JWK, JWK &lt;&gt; PEM, export JWKS for jwks_uri</p>
            <a href="/tools/jwk-generator" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open JWK Generator</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/hmac-tool.svg" loading="lazy" width="24" alt="" /></div>
              <div class="color-white">HMAC Tool</div>
            </div>
            <p class="toolkit-description">Generate &amp; verify HMAC SHA-256/384/512 for webhooks.</p>
            <a href="/tools/hmac-signature-generator-verifier" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open HMAC Tool</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/saml-testing-tool.svg" loading="lazy" alt="" /></div>
              <div class="color-white">SAML Testing Tool</div>
            </div>
            <p class="toolkit-description">Spin up a mock SAML SP to test SAML assertions.</p>
            <a href="https://samlsp.com/en/" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open SAML Testing Tool</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/totp-authenticator.svg" loading="lazy" alt="" /></div>
              <div class="color-white">TOTP Authenticator</div>
            </div>
            <p class="toolkit-description">Quickly test OTP codes (RFC 6238).</p>
            <a href="/tools/totp-authenticator" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open TOTP Authenticator</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-_8280b323-5bfe-3f28-a75e-858c11c5fecb-f4d663f6" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/password-hash-generator.svg" loading="lazy" alt="" /></div>
              <div class="color-white">Password Hash Generator and Verifier</div>
            </div>
            <p class="toolkit-description">Client-side tool to generate/verify password hashes with parameters (Argon2id, bcrypt, scrypt, PBKDF2)</p>
            <a href="/tools/password-hash-generator" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open Password Hash Generator and Verifier</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-_5b4a96ea-5a0a-c084-40fa-4ec713761073-f4d663f6" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/base64.svg" loading="lazy" alt="" /></div>
              <div class="color-white">Base64 Decode and Encode</div>
            </div>
            <p class="toolkit-description">Easily encode or decode Base64 strings directly.</p>
            <a href="/tools/base64-decode-encode" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open Base64 Decode/Encode</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-_50250a44-e325-0719-f7a0-f1b5e51e2883-f4d663f6" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/uuid-icon.svg" loading="lazy" alt="" /></div>
              <div class="color-white">UUID v7 Generator &amp; Timestamp Extractor</div>
            </div>
            <p class="toolkit-description">Generate and inspect UUID v7 values directly in your browser.</p>
            <a href="/tools/uuidv7-generator" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open UUID v7 Generator</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-a4f140b3-af24-a532-1fd3-24ea7dc18459-f4d663f6" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/ssl-checker-icon.svg" loading="lazy" alt="" /></div>
              <div class="color-white">SSL Checker</div>
            </div>
            <p class="toolkit-description">Ceck any domain's SSL/TLS certificate. View expiration date, issuer, subject alternative names, and full certificate chain status</p>
            <a href="/tools/ssl-checker" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open SSL Checker</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-a3541d2b-7eed-3c49-5aaf-47ee0aaa464d-f4d663f6" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/oidc-icon.svg" loading="lazy" alt="" /></div>
              <div class="color-white">OIDC Discovery Endpoint Explorer</div>
            </div>
            <p class="toolkit-description">Fetch and inspect any OIDC provider's .well-known/openid-configuration. View    <br />  authorization endpoints, token endpoints, JWKS, scopes, and signing algorithms.</p>
            <a href="/tools/oidc-discovery-endpoint" class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">Open SSL Checker</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div class="w-layout-vflex toolkit-card more-toolkit">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/more.svg" loading="lazy" alt="" /></div>
              <div class="color-white">More Coming Soon</div>
            </div>
            <p class="toolkit-description">We're constantly adding new authentication tools. Stay tuned for more developer resources.</p>
            <div class="w-layout-vflex comming-soon">
              <div>Comming Soon</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="toolkit-learn-more-section">
    <div class="login-default-inner-section glossary-content-inner-section">
      <div class="login-default-inner-section gallery-banner toolkit">
        <h2 class="toolkit-h2">Learn More</h2>
        <p class="glossary-subtitle subtitle-paddings toolkit">Want the &quot;why&quot; behind the tools? Start here.</p>
      </div>
      <div class="w-layout-vflex toolkit-learn-more-container">
        <a href="/post/jwe-vs-jwt" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">JWE vs JWT: Key Differences, Use Cases, and Security Tips</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href="/post/what-is-jwks" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">What is JWKS?: JSON Web Key Set Explained with Examples</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href="/post/what-is-totp" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">What is TOTP (RFC 6238 explained)</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href="/post/5-common-totp-mistakes" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">5 Common TOTP Mistakes Developers Make</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href="/post/password-hashing-salting-function-and-algorithm-explained" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">Password Hashing &amp; Salting - Function and Algorithm Explained</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href="/post/password-hashing-how-to-pick-the-right-hashing-function" target="_blank" class="link-block-6 w-inline-block">
          <div class="w-layout-hflex toolkit-learn-more">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon more-toolkit"><img src="/images/article.svg" loading="lazy" alt="" /></div>
              <div class="color-white">Password Hashing: How to Pick the Right Hashing Function</div>
            </div>
            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">Read Article</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

</div>
