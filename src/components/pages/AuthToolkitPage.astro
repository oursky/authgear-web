            <p class="toolkit-description">{T('oidcDesc')}</p>
            <a href={localizedPath(locale, "/tools/oidc-discovery-endpoint")} class="toolkit-button w-inline-block">
              <div class="toolkit-button-label">{T('oidcOpen')}</div><img src="/images/link.svg" loading="lazy" alt="" class="image-94" />
            </a>
          </div>
          <div id="w-node-passkey-demo-card" class="w-layout-vflex toolkit-card">
            <div class="w-layout-hflex flex-block-83">
              <div class="toolkit-icon"><img src="/images/passkey-demo.svg" loading="lazy" alt="" /></div>
              <div class="color-white">{T('passkeyName')}</div>
            </div>
            <p class="toolkit-description">{T('passkeyDesc')}</p>
