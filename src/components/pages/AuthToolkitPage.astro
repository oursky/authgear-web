            <div class="w-layout-hflex flex-block-84">
              <div class="text-block-86">{T('readArticle')}</div><img src="/images/article-link.svg" loading="lazy" alt="" />
            </div>
          </div>
        </a>
        <a href={localizedPath(locale, "/post/password-hashing-how-to-pick-the-right-hashing-function")} target="_blank" class="link-block-6 w-inline-block">
