---
interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const starLabel = locale === 'zh-TW'
  ? '到 GitHub 幫我們按顆 ⭐ 追蹤最新進展'
  : 'Star us on GitHub and stay updated';
---
<aside class="blog-post__sidebar">
  <a
    href="https://discord.gg/Kdn5vcYwAS"
    target="_blank"
    rel="noreferrer"
    class="blog-post__sidebar-discord"
    aria-label="Join the Authgear Discord community"
  >
    <img
      src="/images/blog/discord-community.jpg"
      alt="Join other product managers and engineers on Discord"
      loading="lazy"
      width="300"
      height="300"
    />
  </a>
  <div class="blog-post__sidebar-star">
    <p class="blog-post__sidebar-star-label">{starLabel}</p>
    <iframe
      src="https://ghbtns.com/github-btn.html?user=authgear&repo=authgear-server&type=star&count=true&size=large"
      frameborder="0"
      scrolling="0"
      width="150"
      height="30"
      title="Star authgear/authgear-server on GitHub"
      loading="lazy"
    ></iframe>
  </div>
</aside>
