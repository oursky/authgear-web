---
interface Props {
  title: string;
  /**
   * Class applied to the panel, e.g. "nav-menu-dropdown-list" for list-style
   * panels or "nav-menu-dropdown-list-full-width" for the wide products panel.
   */
  panelClass: string;
  /** Optional extra modifier classes on the panel (e.g. "developers"). */
  panelModifier?: string;
}
const { title, panelClass, panelModifier } = Astro.props;
const panelId = `nav-dd-${Math.random().toString(36).slice(2, 10)}`;
const panelClassList = [panelClass, panelModifier].filter(Boolean).join(' ');
---

<div class="nav-menu-dropdown" data-nav-dropdown>
  <button
    type="button"
    class="dropdown-toggle"
    aria-expanded="false"
    aria-controls={panelId}
    data-nav-dropdown-toggle
  >
    <span class="nav-menu-dropdown-toggle-title">{title}</span>
    <svg
      class="nav-menu-dropdown-icon"
      width="12"
      height="12"
      viewBox="0 0 12 12"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M2 4l4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  <div id={panelId} class={panelClassList} role="region" aria-label={title} data-nav-dropdown-panel>
    <slot />
  </div>
</div>

<style is:global>
  /* Replace the base positioning/hiding that used to come from webflow's
     .w-dropdown / .w-dropdown-list classes, so we can drop those runtime
     hooks entirely. */
  .nav-menu-dropdown {
    position: relative;
    z-index: 900;
  }
  .dropdown-toggle {
    background: none;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .dropdown-toggle:focus-visible {
    outline: 2px solid var(--primary-1, #0043e0);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .nav-menu-dropdown-list,
  .nav-menu-dropdown-list-full-width {
    display: none;
    position: absolute;
    min-width: 100%;
  }
  .nav-menu-dropdown-icon {
    transition: transform 0.2s ease;
  }
  .dropdown-toggle[aria-expanded='true'] .nav-menu-dropdown-icon {
    transform: rotate(180deg);
  }

  /* Desktop: panels hang a little below the bar instead of touching it. The
     gap is bridged by an invisible ::before strip that belongs to the panel,
     so the pointer can cross it without leaving the dropdown wrapper, which
     would otherwise close the menu on mouseleave. */
  @media (min-width: 992px) {
    .nav-menu-dropdown {
      --nav-panel-gap: 8px;
    }
    .nav-menu-dropdown-list.w--open,
    .nav-menu-dropdown-list-full-width.w--open {
      top: calc(100% + var(--nav-panel-gap));
      /* Set by the script when a panel would run past the viewport edge. */
      transform: translateX(var(--nav-panel-shift, 0px));
    }
    .nav-menu-dropdown-list.w--open::before,
    .nav-menu-dropdown-list-full-width.w--open::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: calc(-1 * var(--nav-panel-gap));
      height: var(--nav-panel-gap);
    }

    /* Products used to be a viewport-wide sheet. Make it a contained, rounded
       panel like the other menus. Its wrapper goes static so the panel is
       positioned against the header container instead of the toggle, which
       anchors it to the logo's left edge and keeps it inside the viewport. */
    .container-header {
      position: relative;
    }
    .nav-menu-dropdown:has(> .nav-menu-dropdown-list-full-width) {
      position: static;
    }
    .nav-menu-dropdown-list-full-width.w--open {
      position: absolute;
      left: 24px;
      right: auto;
      min-width: 0; /* the shared base rule says 100%, which would beat max-width */
      width: max-content;
      max-width: calc(100% - 48px);
      padding: 32px;
      border-radius: 16px;
      box-shadow: 0 9px 21.6px #0000001a;
    }
    .nav-menu-dropdown .nav-menu-dropdown-list-full-width .nav-full-width-wrapper {
      display: block;
      position: static;
      width: auto;
      padding: 0;
      background: transparent;
      box-shadow: none;
    }
    .nav-menu-dropdown .nav-menu-dropdown-list-full-width .nav-full-width-inner {
      width: auto;
      max-width: none;
      grid-template-columns: repeat(5, minmax(0, max-content));
      column-gap: 32px;
    }
  }
  /* Narrow desktops: the five columns no longer fit at their natural width,
     so let the link labels wrap instead of spilling out of the panel. */
  @media (min-width: 992px) and (max-width: 1279px) {
    .nav-menu-dropdown .nav-menu-dropdown-list-full-width .nav-menu-dropdown-link {
      white-space: normal;
    }
  }

  /* Mobile: sections are stacked in the drawer; animate open/close instead
     of show/hide so it no longer jumps. */
  @media (max-width: 991px) {
    .nav-menu-dropdown {
      width: 100%;
    }
    .nav-menu-dropdown > .dropdown-toggle {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-align: left;
      padding: 0;
    }
    .nav-menu-dropdown > .dropdown-toggle .nav-menu-dropdown-toggle-title {
      flex: 1 1 auto;
    }
    .nav-menu-dropdown > .dropdown-toggle .nav-menu-dropdown-icon {
      flex: 0 0 auto;
      margin-left: 12px;
    }
    .nav-menu-dropdown-list,
    .nav-menu-dropdown-list-full-width {
      display: block;
      position: static;
      overflow: hidden;
      pointer-events: none;
      max-height: 0;
      opacity: 0;
      transform: translateY(-4px);
      transition:
        max-height 0.3s ease,
        opacity 0.2s ease,
        transform 0.3s ease;
    }
    .nav-menu-dropdown-list.w--open,
    .nav-menu-dropdown-list-full-width.w--open {
      pointer-events: auto;
      max-height: 1200px;
      opacity: 1;
      transform: translateY(0);
    }
    /* Keep headers at a consistent height — the base stylesheet sets
       .dropdown-toggle.w--open { height: auto } on mobile, which caused
       the section to shrink and the whole menu to jump. */
    .dropdown-toggle,
    .dropdown-toggle[aria-expanded='true'],
    .dropdown-toggle.w--open {
      height: 64px;
    }
  }
</style>

<script>
  const DESKTOP = window.matchMedia('(min-width: 992px)');
  const FINE_POINTER = window.matchMedia('(hover: hover) and (pointer: fine)');

  const dropdowns = Array.from(
    document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'),
  );

  function toggleEl(d: HTMLElement) {
    return d.querySelector<HTMLElement>('[data-nav-dropdown-toggle]');
  }
  function panelEl(d: HTMLElement) {
    return d.querySelector<HTMLElement>('[data-nav-dropdown-panel]');
  }

  // Desktop panels are anchored to their toggle's left edge. On narrower
  // desktops a wide panel can run past the right edge of the viewport, so
  // after opening, measure it and shift it left just enough to fit, without
  // pushing its left edge past the same margin. The shift is a custom
  // property the desktop CSS reads; mobile styles never see it.
  const VIEWPORT_MARGIN = 24;
  function keepInViewport(panel: HTMLElement) {
    panel.style.removeProperty('--nav-panel-shift');
    if (!DESKTOP.matches) return;
    const rect = panel.getBoundingClientRect();
    const overflow = rect.right - (window.innerWidth - VIEWPORT_MARGIN);
    if (overflow <= 0) return;
    const room = Math.max(0, rect.left - VIEWPORT_MARGIN);
    panel.style.setProperty('--nav-panel-shift', `${-Math.min(overflow, room)}px`);
  }

  function setOpen(d: HTMLElement, open: boolean) {
    toggleEl(d)?.setAttribute('aria-expanded', open ? 'true' : 'false');
    const panel = panelEl(d);
    if (!panel) return;
    panel.classList.toggle('w--open', open);
    if (open) keepInViewport(panel);
    else panel.style.removeProperty('--nav-panel-shift');
  }

  function closeAll(except?: HTMLElement) {
    dropdowns.forEach((d) => {
      if (d !== except) setOpen(d, false);
    });
  }

  dropdowns.forEach((d) => {
    const toggle = toggleEl(d);
    if (!toggle) return;

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
      closeAll(wasOpen ? undefined : d);
      setOpen(d, !wasOpen);
    });

    // Desktop hover-open (only on devices with a real pointer).
    d.addEventListener('mouseenter', () => {
      if (!DESKTOP.matches || !FINE_POINTER.matches) return;
      closeAll(d);
      setOpen(d, true);
    });
    d.addEventListener('mouseleave', () => {
      if (!DESKTOP.matches || !FINE_POINTER.matches) return;
      setOpen(d, false);
    });
  });

  // Outside click closes everything.
  document.addEventListener('click', (event) => {
    const target = event.target as Node | null;
    if (!target) return;
    if (!dropdowns.some((d) => d.contains(target))) closeAll();
  });

  // Escape closes and restores focus.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = dropdowns.find(
      (d) => toggleEl(d)?.getAttribute('aria-expanded') === 'true',
    );
    if (!open) return;
    closeAll();
    toggleEl(open)?.focus();
  });
</script>
